{
  "name": "dashboard-old",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "migrate:import": "bun run ../../scripts/migrate/import-convex.ts",
    "migrate:import:dry-run": "bun run ../../scripts/migrate/import-convex.ts --dry-run",
    "migrate:import:verbose": "bun run ../../scripts/migrate/import-convex.ts --verbose",
    "migrate:import:users": "bun run ../../scripts/migrate/import-convex.ts --collection users",
    "migrate:import:events": "bun run ../../scripts/migrate/import-convex.ts --collection events",
    "migrate:import:phase1": "bun run ../../scripts/migrate/import-convex.ts --collection organizationSettings --collection sponsorDomains",
    "migrate:import:phase2": "bun run ../../scripts/migrate/import-convex.ts --collection users --collection public_profiles --collection events --collection officerInvitations --collection directOnboardings --collection invites --collection constitutions",
    "migrate:files": "bun run ../../scripts/migrate/migrate-files.ts",
    "migrate:files:dry-run": "bun run ../../scripts/migrate/migrate-files.ts --dry-run",
    "migrate:files:verbose": "bun run ../../scripts/migrate/migrate-files.ts --verbose",
    "migrate:files:verify": "bun run ../../scripts/migrate/migrate-files.ts --verify",
    "migrate:files:avatars": "bun run ../../scripts/migrate/migrate-files.ts --path avatars/",
    "migrate:files:receipts": "bun run ../../scripts/migrate/migrate-files.ts --path reimbursements/",
    "migrate:files:deposits": "bun run ../../scripts/migrate/migrate-files.ts --path fundDeposits/",
    "migrate:files:force": "bun run ../../scripts/migrate/migrate-files.ts --force-remigrate",
    "migrate:verify": "npx tsx ../../scripts/migrate/verify-migration.ts",
    "migrate:verify:verbose": "npx tsx ../../scripts/migrate/verify-migration.ts --verbose",
    "migrate:verify:dry-run": "npx tsx ../../scripts/migrate/verify-migration.ts --dry-run",
    "migrate:verify:html": "npx tsx ../../scripts/migrate/verify-migration.ts --format html",
    "migrate:verify:txt": "npx tsx ../../scripts/migrate/verify-migration.ts --format txt",
    "migrate:verify:count": "npx tsx ../../scripts/migrate/verify-migration.ts --check record_count",
    "migrate:verify:sampling": "npx tsx ../../scripts/migrate/verify-migration.ts --check sampling",
    "migrate:verify:integrity": "npx tsx ../../scripts/migrate/verify-migration.ts --check referential_integrity",
    "migrate:verify:query": "npx tsx ../../scripts/migrate/verify-migration.ts --check query_equivalence",
    "migrate:verify:fields": "npx tsx ../../scripts/migrate/verify-migration.ts --check field_validation",
    "migrate:verify:users": "npx tsx ../../scripts/migrate/verify-migration.ts --collection users",
    "migrate:verify:events": "npx tsx ../../scripts/migrate/verify-migration.ts --collection events",
    "migrate:verify:complete": "npx tsx ../../scripts/migrate/verify-migration.ts --verbose --format html"
  },
