---
interface LinkRow {
  label: string;
  href?: string;
  description?: string;
}

interface Props {
  title: string;            // "Design Chair"
  updatedText?: string;     // "Last updated Nov 4, 2025"
  currentName: string;      // "Name"
  currentMeta?: string;     // "Design Chair • 2025–2026"
  congratsText?: string;    // optional line under current officer
  whatToKnow: string;
  links: LinkRow[];
  fellowText: string;
}

const {
  title,
  updatedText = "Last updated April 23, 2026",
  currentName,
  currentMeta = "Role | Date Serving",
  congratsText = `Congratulations on becoming the new ${title}!`,
  whatToKnow,
  links,
  fellowText,
}: Props = Astro.props;
---

<div class="w-[92%] md:w-[70%] mx-auto">
  <h1 class="text-[6vw] md:text-[2.6vw] font-black tracking-tight">
    {title}
  </h1>

  <span class="mt-[1.2vw] inline-block rounded bg-orange-100 px-[1vw] py-[0.5vw] md:px-[0.5vw] md:py-[0.2vw] text-[2.3vw] md:text-[0.75vw] text-orange-800">
    {updatedText}
  </span>

  <div class="mt-[3.2vw] md:mt-[1.4vw] rounded-[1.6vw] md:rounded-[0.6vw] border border-black/15 bg-white p-[4vw] md:p-[1.6vw]">
    <h2 class="text-[4vw] md:text-[1.2vw] font-black">
      Current {title}
    </h2>

    <div class="mt-[2.2vw] md:mt-[0.9vw] rounded-[1.2vw] md:rounded-[0.5vw] border border-black/10 p-[2.6vw] md:p-[0.9vw] flex items-center gap-[2.4vw] md:gap-[0.9vw]">
      <div class="h-[8vw] w-[8vw] md:h-[2.4vw] md:w-[2.4vw] rounded-full bg-black/15"></div>
      <div>
        <p class="text-[3.2vw] md:text-[1vw] font-semibold">{currentName}</p>
        <p class="text-[2.4vw] md:text-[0.75vw] text-black/60">{currentMeta}</p>
      </div>
    </div>

    <p class="mt-[2.2vw] md:mt-[0.8vw] text-[2.6vw] md:text-[0.85vw] text-black/70">
      {congratsText}
    </p>

    <div class="mt-[4vw] md:mt-[1.6vw] border-t border-black/10"></div>

    <h3 class="mt-[4vw] md:mt-[1.6vw] text-[3.6vw] md:text-[1.15vw] font-black">
      What to know
    </h3>
    <div class="mt-[1.2vw] md:mt-[0.6vw] text-[2.8vw] md:text-[0.9vw] text-black/70 leading-relaxed
                [&_strong]:text-black [&_strong]:font-semibold
                [&_ul]:list-disc [&_ul]:pl-[4vw] [&_ul]:md:pl-[1.4vw] [&_ul]:mt-[1vw] [&_ul]:md:mt-[0.4vw] [&_ul]:space-y-[0.8vw] [&_ul]:md:space-y-[0.3vw]
                [&_ol]:list-decimal [&_ol]:pl-[4vw] [&_ol]:md:pl-[1.4vw] [&_ol]:mt-[1vw] [&_ol]:md:mt-[0.4vw] [&_ol]:space-y-[0.8vw] [&_ol]:md:space-y-[0.3vw]
                [&_p]:mt-[1.6vw] [&_p]:md:mt-[0.6vw]"
      set:html={whatToKnow}
    />

    <div class="mt-[4vw] md:mt-[1.6vw] border-t border-black/10"></div>

    <h3 class="mt-[4vw] md:mt-[1.6vw] text-[3.6vw] md:text-[1.15vw] font-black">
      Contacts/Useful Links
    </h3>

    <div class="mt-[1.6vw] md:mt-[0.8vw] space-y-[2.6vw] md:space-y-[1vw]">
      {links.map((l) => (
        <div class="border-t border-black/10 pt-[2.2vw] md:pt-[0.9vw]">
          <div class="flex items-center justify-between gap-[2vw]">
            <p class="text-[2.8vw] md:text-[0.9vw] font-semibold">{l.label}</p>
            {l.href && (
              <a class="text-[2.6vw] md:text-[0.85vw] text-[#0A66A6] underline" href={l.href}>
                Open &rarr;
              </a>
            )}
          </div>
          {l.description && (
            <p class="mt-[0.8vw] md:mt-[0.3vw] text-[2.6vw] md:text-[0.85vw] text-black/65">
              {l.description}
            </p>
          )}
        </div>
      ))}
    </div>

    <div class="mt-[4vw] md:mt-[1.6vw] border-t border-black/10"></div>

    <h3 class="mt-[4vw] md:mt-[1.6vw] text-[3.6vw] md:text-[1.15vw] font-black">
      Fellow Officers to Know
    </h3>
    <p class="mt-[1.2vw] md:mt-[0.6vw] text-[2.8vw] md:text-[0.9vw] text-black/70 leading-relaxed">
      {fellowText}
    </p>
  </div>
</div>