# Convex configuration
# Get the self-hosted URL from your Convex dashboard
CONVEX_SELF_HOSTED_URL=https://your-convex-instance.com/
CONVEX_SELF_HOSTED_ADMIN_KEY=your-admin-key

# Logto authentication configuration
# Client-side environment variables (prefixed with VITE_)
VITE_LOGTO_ENDPOINT=https://your-logto-instance.com
VITE_LOGTO_APP_ID=your-logto-app-id
VITE_LOGTO_REDIRECT_URI=http://localhost:3000/callback

# Server-side Logto configuration
# Used for Management API access and webhook verification
# These should NOT be prefixed with VITE_ as they are server-only
LOGTO_ENDPOINT=https://your-logto-instance.com
LOGTO_APP_ID=your-logto-app-id
LOGTO_APP_SECRET=your-logto-app-secret
LOGTO_WEBHOOK_SECRET=your-logto-webhook-secret

# App URL (used for redirects after login/logout)
VITE_APP_URL=http://localhost:3000

# Firebase Admin SDK (Migration/Export - server-side only)
# Required for exporting data from Firebase during migration
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
