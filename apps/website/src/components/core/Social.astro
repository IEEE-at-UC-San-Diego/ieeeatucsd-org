---
import { Image } from "astro:assets";
import jellyfish from "../../images/jellyfish.png";
import { FaDiscord } from "react-icons/fa";
import { RiInstagramFill } from "react-icons/ri";
import { MdEmail } from "react-icons/md";
import SectionHeading from "./SectionHeading.astro";

const links = [
  {
    href: "https://www.instagram.com/ieee.at.ucsd",
    label: "Instagram",
    icon: RiInstagramFill,
  },
  {
    href: "https://discord.gg/XxfjqZSjca",
    label: "Discord",
    icon: FaDiscord,
  },
  {
    href: "mailto:ieee@ucsd.edu",
    label: "Email",
    icon: MdEmail,
  },
];
---

<section class="page-section" aria-labelledby="social-heading">
  <SectionHeading
    id="social-heading"
    eyebrow="Stay in the loop"
    title="Social media"
    align="center"
  >
    Event announcements and reminders go out on Discord and Instagram first.
  </SectionHeading>

  <div
    class="mt-10 ieee-panel overflow-hidden px-6 py-8 sm:px-10 sm:py-10 relative"
  >
    <div
      class="relative z-10 flex flex-wrap justify-center gap-8 sm:gap-14"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}
            class="ieee-btn ieee-btn-ghost flex-col !rounded-2xl min-w-[7.5rem] py-5"
          >
            <link.icon className="text-3xl" aria-hidden="true" />
            <span class="mt-2 font-medium">{link.label}</span>
          </a>
        ))
      }
    </div>
    <Image
      src={jellyfish}
      alt=""
      class="pointer-events-none absolute bottom-0 right-4 w-28 sm:w-40 opacity-80"
    />
  </div>
</section>
