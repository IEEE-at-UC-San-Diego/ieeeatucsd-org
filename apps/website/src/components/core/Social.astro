---
import { Image } from "astro:assets";
import jellyfish from "../../images/jellyfish.png";
import { FaDiscord } from "react-icons/fa";
import { RiInstagramFill } from "react-icons/ri";
import { MdEmail } from "react-icons/md";
import SectionHeading from "./SectionHeading.astro";

const links = [
  {
    href: "https://www.instagram.com/ieee.at.ucsd",
    label: "Instagram",
    handle: "@ieee.at.ucsd",
    icon: RiInstagramFill,
  },
  {
    href: "https://discord.gg/XxfjqZSjca",
    label: "Discord",
    handle: "discord.gg/XxfjqZSjca",
    icon: FaDiscord,
  },
  {
    href: "mailto:ieee@ucsd.edu",
    label: "Email",
    handle: "ieee@ucsd.edu",
    icon: MdEmail,
  },
];
---

<section class="page-section !pt-4 md:!pt-8" aria-labelledby="social-heading">
  <div class="flex items-end justify-between gap-8">
    <SectionHeading id="social-heading" title="Social media">
      Stay connected with us on Discord and Instagram! We regularly post
      information on upcoming events and competitions.
    </SectionHeading>
    <Image
      src={jellyfish}
      alt=""
      class="pointer-events-none -mb-2 hidden w-32 shrink-0 -rotate-3 sm:block lg:w-40"
    />
  </div>

  <ul
    class="mt-12 grid border-t border-white/10 sm:grid-cols-3 sm:border-x sm:border-b md:mt-14"
    data-reveal
  >
    {
      links.map((link) => (
        <li class="social-cell border-b border-white/10 sm:border-b-0 sm:border-r sm:last:border-r-0">
          <a
            href={link.href}
            target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={link.href.startsWith("mailto:") ? undefined : "noreferrer"}
            class="social-link group relative flex items-center gap-4 py-6 text-white no-underline sm:px-6 sm:py-7"
          >
            <span class="social-icon" aria-hidden="true">
              <link.icon className="text-[1.5rem] text-ieee-blue-100" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-display text-[clamp(1.25rem,2vw,1.6rem)] font-semibold leading-tight tracking-[-0.03em]">
                {link.label}
              </span>
              <span class="mono-label mt-1 block !normal-case !tracking-[0.04em] !text-white/60 break-all">
                {link.handle}
              </span>
            </span>
            <span
              class="social-arrow shrink-0 pr-1 text-xl text-white/45 sm:pr-0"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .social-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(136, 191, 236, 0.22);
    border-radius: 0.65rem;
    background: rgba(136, 191, 236, 0.06);
    transition:
      border-color 250ms ease,
      background-color 250ms ease;
  }

  .social-arrow {
    transition:
      transform 300ms cubic-bezier(0.23, 1, 0.32, 1),
      color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover .social-arrow {
      transform: translate(3px, -3px);
      color: #f3c135;
    }

    .social-link:hover .social-icon {
      border-color: rgba(136, 191, 236, 0.55);
      background: rgba(136, 191, 236, 0.12);
    }

    .social-link {
      transition: background-color 250ms ease;
    }

    @media (min-width: 640px) {
      .social-link:hover {
        background: rgba(136, 191, 236, 0.05);
      }
    }
  }
</style>
