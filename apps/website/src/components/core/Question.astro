---
const { question, answer } = Astro.props;
---

<details class="group border-b border-ieee-blue-100/12">
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden"
  >
    <h3 class="font-display text-lg font-medium text-white md:text-xl">
      {question}
    </h3>
    <span
      class="relative mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ieee-blue-100/25 text-ieee-blue-100 transition-colors duration-200 group-hover:border-ieee-blue-100/50 group-open:border-ieee-yellow/60 group-open:text-ieee-yellow"
      aria-hidden="true"
    >
      <span class="absolute h-px w-3.5 bg-current"></span>
      <span
        class="absolute h-3.5 w-px bg-current transition-transform duration-300 ease-out group-open:rotate-90 group-open:opacity-0"
      ></span>
    </span>
  </summary>
  <p class="copy max-w-3xl pb-6 pr-12">{answer}</p>
</details>
