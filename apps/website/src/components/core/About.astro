---
// Intro block for the project pages: headline on the left, statement on the right.
const { title, text } = Astro.props;
---

<section class="page-section" aria-labelledby="about-block-heading">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
    <h2
      id="about-block-heading"
      class="headline lg:col-span-5 text-white"
      data-reveal
    >
      {title}
    </h2>
    <p class="lead lg:col-span-7" data-reveal style="--reveal-delay: 100ms">
      {text}
    </p>
  </div>
</section>
