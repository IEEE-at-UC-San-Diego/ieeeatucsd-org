---
import { Image } from "astro:assets";
import whiteLogoHorizontal from "../../images/logos/white_logo_horizontal.svg";
import pages from "../../data/pages.json";

const currentPath = Astro.url.pathname;
---

<nav
  class="mx-[2.5%] my-2 rounded-2xl border border-white/10 bg-ieee-black/80 backdrop-blur-md px-3 py-2"
  aria-label="Primary"
>
  <div class="flex items-center justify-between gap-3">
    <a href="/" class="shrink-0">
      <Image
        class="w-40 md:w-44"
        src={whiteLogoHorizontal}
        alt="IEEE at UC San Diego"
      />
    </a>

    <ul class="hidden md:flex items-center gap-2 lg:gap-3">
      {
        pages.map((page) => (
          <li class="relative group">
            <a
              href={page.path}
              class:list={[
                "ieee-btn uppercase text-xs lg:text-sm tracking-wide px-3 lg:px-4",
                page.name === "Dashboard"
                  ? "ieee-btn-primary"
                  : "ieee-btn-ghost",
                currentPath === page.path &&
                  page.name !== "Dashboard" &&
                  "border-white/70",
              ]}
            >
              {page.name}
            </a>
            {page.subpages && (
              <div class="nav-submenu absolute left-1/2 top-full z-50 w-max min-w-[12rem] -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible">
                <ul class="rounded-xl border border-white/15 bg-ieee-black/95 p-1">
                  {page.subpages.map((subpage) => (
                    <li>
                      <a
                        href={subpage.path}
                        class="block rounded-lg px-3 py-2 text-sm text-white/90 hover:bg-white/10 hover:text-white"
                      >
                        {subpage.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <details class="md:hidden relative">
      <summary
        class="ieee-btn ieee-btn-ghost !min-h-11 !px-3 list-none cursor-pointer [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <ul
        class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-[min(18rem,calc(100vw-2rem))] rounded-2xl border border-white/15 bg-ieee-black p-3 space-y-2"
      >
        {
          pages.map((page) => (
            <li>
              <a
                href={page.path}
                class:list={[
                  "ieee-btn w-full uppercase text-sm",
                  page.name === "Dashboard"
                    ? "ieee-btn-primary"
                    : "ieee-btn-ghost",
                ]}
              >
                {page.name}
              </a>
              {page.subpages && (
                <ul class="mt-2 space-y-2 pl-2">
                  {page.subpages.map((subpage) => (
                    <li>
                      <a
                        href={subpage.path}
                        class="ieee-btn ieee-btn-ghost w-full text-sm"
                      >
                        {subpage.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</nav>

<style>
  .nav-submenu a {
    @apply no-underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-submenu {
      transition: opacity 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
  }
</style>
