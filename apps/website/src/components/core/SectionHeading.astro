---
// Section opener: <h2> headline with an optional lead (default slot).
interface Props {
  title: string;
  align?: "left" | "center";
  id?: string;
}

const { title, align = "left", id } = Astro.props;
---

<div
  class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}
  data-reveal
>
  <h2 id={id} class="headline text-white">
    {title}
  </h2>
  {
    Astro.slots.has("default") && (
      <p class="lead mt-5">
        <slot />
      </p>
    )
  }
</div>
