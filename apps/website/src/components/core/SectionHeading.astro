---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  id?: string;
}

const { eyebrow, title, align = "left", id } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  {
    eyebrow && (
      <p class="eyebrow text-ieee-yellow text-xs md:text-sm mb-3">{eyebrow}</p>
    )
  }
  <h2
    id={id}
    class="font-display font-bold text-[clamp(1.7rem,4vw,2.6rem)] text-white"
  >
    {title}
  </h2>
  {
    Astro.slots.has("default") && (
      <p class="mt-4 text-lead text-white/75 text-[clamp(1rem,1.6vw,1.15rem)]">
        <slot />
      </p>
    )
  }
</div>
