---
// Opening block of an inner page: eyebrow + large display title (+ optional lead).
// `eyebrow` is optional; the title text is always the page's <h1>.
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="page-hero bp-grid">
  {
    eyebrow && (
      <p class="eyebrow" data-reveal>
        {eyebrow}
      </p>
    )
  }
  <h1
    class:list={["display max-w-5xl", eyebrow && "mt-6"]}
    data-reveal
    style="--reveal-delay: 60ms"
  >
    {title}
  </h1>
  {
    Astro.slots.has("default") && (
      <p class="lead mt-6 max-w-2xl" data-reveal style="--reveal-delay: 140ms">
        <slot />
      </p>
    )
  }
</header>
