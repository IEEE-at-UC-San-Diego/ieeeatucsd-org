---
import { Image } from "astro:assets";
import whiteLogoHorizontal from "../../images/logos/white_logo_horizontal.svg";
---

<footer class="w-full py-6 flex justify-center">
  <div
    class="w-[min(100%-1.5rem,72rem)] border border-white/10 rounded-2xl px-5 py-4 flex flex-col md:flex-row justify-between items-center gap-3 bg-black/30"
  >
    <a href="/">
      <Image
        class="w-40"
        src={whiteLogoHorizontal}
        alt="IEEE at UC San Diego"
      />
    </a>
    <nav class="flex items-center gap-5" aria-label="Legal">
      <a
        href="/terms-of-service"
        class="text-white/70 hover:text-white text-sm"
      >
        Terms of Service
      </a>
      <a href="/privacy-policy" class="text-white/70 hover:text-white text-sm">
        Privacy Policy
      </a>
    </nav>
    <p class="text-white/70 text-sm">Made by IEEE at UC San Diego webmasters</p>
  </div>
</footer>
