---
import { Image } from "astro:assets";
import whiteLogoHorizontal from "../../images/logos/white_logo_horizontal.svg";
---

<footer class="mt-8 border-t border-white/10">
  <div
    class="page-main flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between"
  >
    <a href="/" aria-label="IEEE at UC San Diego home">
      <Image
        class="w-40 opacity-90"
        src={whiteLogoHorizontal}
        alt="IEEE at UC San Diego"
      />
    </a>
    <nav class="flex items-center gap-6" aria-label="Legal">
      <a
        href="/terms-of-service"
        class="text-sm text-white/60 no-underline transition-colors hover:text-white"
      >
        Terms of Service
      </a>
      <a
        href="/privacy-policy"
        class="text-sm text-white/60 no-underline transition-colors hover:text-white"
      >
        Privacy Policy
      </a>
    </nav>
    <p class="mono-label !normal-case !tracking-[0.04em]">
      Made by IEEE at UC San Diego webmasters
    </p>
  </div>
</footer>
