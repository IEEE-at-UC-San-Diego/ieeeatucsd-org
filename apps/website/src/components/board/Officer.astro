---
import { MdEmail } from "react-icons/md";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ieeeMark from "../../images/logos/white_logo_only.svg";

interface Props {
  name: string;
  position: string;
  picture: ImageMetadata | null;
  email?: string;
  eager?: boolean;
}

const { name, position, picture, email, eager = false } = Astro.props as Props;

function officerInitials(fullName: string): string {
  const parts = fullName.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0]!.slice(0, 1).toUpperCase();
  return `${parts[0]!.slice(0, 1)}${parts[parts.length - 1]!.slice(0, 1)}`.toUpperCase();
}

const initials = officerInitials(name);
---

<div class="text-white">
  <div
    class="group md:w-[20vw] w-[35vw] aspect-[334/440] bg-gradient-to-t from-ieee-blue-100/5 to-ieee-blue-100/25 rounded-[10%] flex flex-col items-center relative border border-white/10"
  >
    <div
      class="relative md:w-[18vw] w-[31vw] aspect-[334/440] md:rounded-[1.5vw] rounded-[3vw] overflow-hidden mt-[5%] mb-[3%]"
    >
      {
        picture ? (
          <Image
            src={picture}
            alt={`${name} portrait`}
            class="w-full h-full object-cover"
            width={334}
            height={440}
            widths={[160, 240, 334, 440]}
            sizes="(max-width: 768px) 31vw, 18vw"
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div
            class="relative w-full h-full overflow-hidden bg-[#121a2e]"
            role="img"
            aria-label={`${name}`}
          >
            <div
              class="absolute inset-0"
              style="background:
                radial-gradient(80% 55% at 50% 18%, rgba(136, 191, 236, 0.22) 0%, rgba(136, 191, 236, 0.08) 36%, rgba(35, 51, 99, 0) 68%),
                linear-gradient(180deg, #2a3f6e 0%, #1a2744 46%, #0d1528 100%);"
            />
            <div class="absolute inset-x-0 top-[36%] flex -translate-y-1/2 flex-col items-center">
              <Image
                src={ieeeMark}
                alt=""
                class="w-[28%] opacity-70 mb-[0.8vw]"
                widths={[80, 120, 160]}
                sizes="(max-width: 768px) 9vw, 5vw"
              />
              <span class="font-display font-extrabold tracking-tight text-white md:text-[3.8vw] text-[7.2vw] leading-none">
                {initials}
              </span>
            </div>
          </div>
        )
      }
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          radial-gradient(66% 46% at 50% 104%, rgba(23, 37, 84, 0.60) 0%, rgba(23, 37, 84, 0.42) 20%, rgba(30, 58, 138, 0.22) 38%, rgba(30, 58, 138, 0) 56%),
          radial-gradient(55% 42% at 0% 100%, rgba(23, 37, 84, 0.62) 0%, rgba(23, 37, 84, 0.44) 16%, rgba(30, 58, 138, 0.24) 28%, rgba(30, 58, 138, 0) 44%),
          radial-gradient(55% 42% at 100% 100%, rgba(23, 37, 84, 0.62) 0%, rgba(23, 37, 84, 0.44) 16%, rgba(30, 58, 138, 0.24) 28%, rgba(30, 58, 138, 0) 44%),
          linear-gradient(to top, rgba(23, 37, 84, 0.96) 0%, rgba(23, 37, 84, 0.84) 8%, rgba(30, 58, 138, 0.46) 16%, rgba(30, 58, 138, 0) 30%);
        "
      >
      </div>
      <div class="absolute inset-x-0 bottom-0 backdrop-blur-sm">
        <div
          class="flex items-center justify-center px-[1vw] py-[0.8vw] md:py-[0.6vw]"
        >
          <span
            class="text-white md:text-[1vw] text-[2vw] font-semibold uppercase tracking-wide leading-tight text-center"
          >
            {position}
          </span>
        </div>
      </div>
    </div>

    <div class="w-[85%] flex flex-col items-center text-center">
      <p
        class="md:text-[1.6vw] text-[3.2vw] font-semibold tracking-tight md:leading-[2.1vw] leading-[4.2vw]"
      >
        {name}
      </p>
    </div>

    {
      email && (
        <div class="w-[85%] pb-[1.2vw] pt-[0.6vw] flex justify-center">
          <a
            href={`mailto:${email}`}
            class="group/email inline-flex items-center gap-[0.6vw] rounded-full bg-white/5 hover:bg-white/10 border border-white/10 px-[1.2vw] py-[0.4vw] text-ieee-yellow md:text-[0.85vw] text-[1.7vw] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ieee-yellow/60"
            aria-label={`Email ${name}`}
            title={email}
          >
            <MdEmail className="md:text-[1.1vw] text-[2.2vw] opacity-80 group-hover/email:opacity-100 transition-opacity" />
            <span class="truncate max-w-[14vw] md:max-w-[12vw]">{email}</span>
          </a>
        </div>
      )
    }
  </div>
</div>
