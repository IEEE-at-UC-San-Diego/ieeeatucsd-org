---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  position: string;
  picture: ImageMetadata | null;
  email?: string;
  eager?: boolean;
  variant?: "card" | "feature";
}

const {
  name,
  position,
  picture,
  email,
  eager = false,
  variant = "card",
} = Astro.props as Props;

const isFeature = variant === "feature";

function officerInitials(fullName: string): string {
  const parts = fullName.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0]!.slice(0, 1).toUpperCase();
  return `${parts[0]!.slice(0, 1)}${parts[parts.length - 1]!.slice(0, 1)}`.toUpperCase();
}

const initials = officerInitials(name);

// Let long addresses break after the "@" rather than mid-domain. The zero
// width space is invisible but gives the line breaker a clean break point.
const emailBreakable = email ? email.replace("@", "@\u200B") : "";
---

<article
  class:list={[
    "group min-w-0",
    isFeature
      ? "grid items-center gap-7 sm:grid-cols-[minmax(0,17rem)_1fr] sm:gap-10"
      : "flex h-full flex-col",
  ]}
>
  <div class:list={[isFeature && "w-full"]}>
    <div
      class:list={[
        "relative w-full overflow-hidden border border-white/10 bg-[#0d1324]",
        isFeature
          ? "aspect-[4/5] rounded-[1.25rem]"
          : "aspect-[4/5] rounded-2xl",
      ]}
    >
      {
        picture ? (
          <Image
            src={picture}
            alt={`${name} portrait`}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            width={440}
            height={550}
            widths={[240, 334, 440, 640]}
            sizes={
              isFeature
                ? "(max-width: 640px) 88vw, 272px"
                : "(max-width: 640px) 46vw, (max-width: 1024px) 30vw, 22vw"
            }
            loading={eager ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div
            class="relative h-full w-full overflow-hidden bg-[#0d1324]"
            role="img"
            aria-label={`${name}`}
          >
            <div class="bp-grid absolute inset-0" aria-hidden="true" />
            <span
              class:list={[
                "absolute inset-0 grid place-items-center font-display font-extrabold leading-none tracking-tight text-ieee-blue-100/85",
                isFeature
                  ? "text-[clamp(3rem,7vw,4.5rem)]"
                  : "text-[clamp(2rem,5vw,2.75rem)]",
              ]}
            >
              {initials}
            </span>
          </div>
        )
      }
    </div>
  </div>

  <div class:list={[isFeature ? "" : "mt-4 flex flex-1 flex-col"]}>
    <p
      class:list={[
        "font-semibold tracking-tight text-white",
        isFeature
          ? "text-[clamp(2.1rem,4.4vw,3.5rem)] leading-[1.02]"
          : "text-lg sm:text-xl",
      ]}
    >
      {name}
    </p>
    <p
      class:list={[
        "mono-label text-ieee-blue-100",
        isFeature ? "mt-4 text-[0.8rem]" : "mt-1.5",
      ]}
    >
      {position}
    </p>

    {
      email &&
        (isFeature ? (
          <a
            href={`mailto:${email}`}
            class="group/email mt-6 inline-flex max-w-full items-center gap-2 text-[0.95rem] no-underline text-white/65 transition-colors hover:text-ieee-yellow"
            aria-label={`Email ${name}`}
            title={email}
          >
            <span class="min-w-0 break-words">{emailBreakable}</span>
            <span
              aria-hidden="true"
              class="shrink-0 transition-transform duration-300 ease-out group-hover/email:translate-x-1"
            >
              →
            </span>
          </a>
        ) : (
          <a
            href={`mailto:${email}`}
            class="group/email mt-auto flex items-baseline gap-1.5 border-t border-white/10 pt-3 text-[0.78rem] no-underline text-white/50 transition-colors hover:text-ieee-yellow"
            aria-label={`Email ${name}`}
            title={email}
          >
            <span class="min-w-0 break-words leading-snug">
              {emailBreakable}
            </span>
            <span
              aria-hidden="true"
              class="shrink-0 transition-transform duration-300 ease-out group-hover/email:translate-x-0.5"
            >
              →
            </span>
          </a>
        ))
    }
  </div>
</article>
