---
import type { ImageMetadata } from "astro";
import Officer from "../board/Officer.astro";
import Filter from "../board/Filter.astro";

export interface OfficerRecord {
  name: string;
  position: string;
  picture: string;
  email: string;
  type: string[];
}

interface Props {
  officers: OfficerRecord[];
  heading?: string;
  description?: string;
  footerLink?: {
    href: string;
    label: string;
  };
}

const {
  officers,
  heading = "Meet the board",
  description,
  footerLink,
} = Astro.props;

const blurb =
  description ??
  `Our board comprises ${officers.length} students of varying majors, colleges, and interests! Feel free to reach out for any questions about our position or experiences.`;

const officerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../images/officers/*.webp",
  {
    eager: true,
  },
);

function resolveOfficerImage(picturePath: string): ImageMetadata | null {
  if (!picturePath || picturePath.startsWith("http")) return null;

  const base = picturePath.split("/").pop() || "";
  const filename = base.endsWith(".webp") ? base : `${base}.webp`;

  const key = Object.keys(officerImages).find((k) =>
    k.endsWith(`/${filename}`),
  );
  return key ? (officerImages[key]?.default ?? null) : null;
}

const typeOrder = ["Executives", "Internal", "Events", "Projects"];
const types = ["All", ...typeOrder];

const currentFilter = "All";
const eagerCount = 5;

const [lead, ...rest] = officers;
---

<div class="pb-24 sm:pb-32">
  <header
    class="bp-grid pt-[clamp(1.75rem,3.5vw,2.75rem)] pb-[clamp(1.5rem,3vw,2.25rem)]"
  >
    <div class="board-hero grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="board-hero-intro lg:col-span-6">
        <p class="eyebrow" data-reveal>IEEE at UC San Diego</p>
        <h1
          class="display mt-5 text-[clamp(2.5rem,5vw,3.75rem)]"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          {heading}
        </h1>
        <p class="lead mt-5 max-w-xl" data-reveal style="--reveal-delay: 120ms">
          {blurb}
        </p>

        {
          footerLink && (
            <a
              href={footerLink.href}
              class="btn-link mt-6 inline-flex text-ieee-blue-100"
              data-reveal
              style="--reveal-delay: 160ms"
            >
              {footerLink.label}
            </a>
          )
        }

        <div class="mt-8" data-reveal style="--reveal-delay: 200ms">
          <Filter filters={types} currentFilter={currentFilter} />
        </div>
      </div>

      {
        lead && (
          <div
            class="board-hero-lead lg:col-span-6"
            data-reveal
            style="--reveal-delay: 160ms"
          >
            <Officer
              name={lead.name}
              position={lead.position}
              picture={resolveOfficerImage(lead.picture)}
              email={lead.email}
              variant="feature"
              eager
            />
          </div>
        )
      }
    </div>
  </header>

  <div
    class="mt-10 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-4"
    data-reveal
  >
    {
      rest.map((officer, i) => (
        <div
          class="min-w-0"
          data-officer
          data-types={JSON.stringify(officer.type)}
        >
          <Officer
            name={officer.name}
            position={officer.position}
            picture={resolveOfficerImage(officer.picture)}
            email={officer.email}
            eager={i < eagerCount}
          />
        </div>
      ))
    }
  </div>
</div>
