---
import about from "../../images/about.webp";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import neko from "../../images/neko.webp";
import Officer from "../board/Officer.astro";
import Filter from "../board/Filter.astro";

export interface OfficerRecord {
  name: string;
  position: string;
  picture: string;
  email: string;
  type: string[];
}

interface Props {
  officers: OfficerRecord[];
  heading?: string;
  description?: string;
  footerLink?: {
    href: string;
    label: string;
  };
}

const {
  officers,
  heading = "Meet the board",
  description,
  footerLink,
} = Astro.props;

const blurb =
  description ??
  `Our board comprises ${officers.length} students of varying majors, colleges, and interests! Feel free to reach out for any questions about our position or experiences.`;

const officerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../images/officers/*.webp",
  {
    eager: true,
  },
);

function resolveOfficerImage(picturePath: string): ImageMetadata | null {
  if (!picturePath || picturePath.startsWith("http")) return null;

  const base = picturePath.split("/").pop() || "";
  const filename = base.endsWith(".webp") ? base : `${base}.webp`;

  const key = Object.keys(officerImages).find((k) =>
    k.endsWith(`/${filename}`),
  );
  return key ? (officerImages[key]?.default ?? null) : null;
}

const typeOrder = ["Executives", "Internal", "Events", "Projects"];
const types = ["All", ...typeOrder];

const currentFilter = "All";
const eagerCount = 6;
---

<div
  class="text-white flex flex-col items-center md:mt-[5cqw] mt-[10cqw] mb-[10vh]"
>
  <div class="relative w-[40cqw] md:w-[21cqw] mb-[10vh]">
    <Image src={about} alt="About background image" />
    <Image
      src={neko}
      alt="About image"
      class="absolute top-[10%] left-[16%] aspect-[399/491] object-cover w-[27cqw] md:w-[14cqw] rounded-[2cqw]"
    />
  </div>

  <h1 class="font-display font-bold text-[clamp(1.8rem,4vw,2.8rem)] mt-2">
    {heading}
  </h1>

  <p
    class="md:text-[1.3cqw] text-[2.5cqw] md:w-[56%] w-[70%] my-[3%] font-extralight text-center"
  >
    {blurb}
  </p>

  {
    footerLink && (
      <a
        href={footerLink.href}
        class="mb-[1cqw] text-ieee-yellow md:text-[1cqw] text-[2.2cqw] underline underline-offset-4 hover:text-white transition-colors"
      >
        {footerLink.label}
      </a>
    )
  }

  <Filter filters={types} currentFilter={currentFilter} />

  <div
    class="grid w-full gap-[3cqw] md:grid-cols-3 grid-cols-2 mt-[2vh]"
  >
    {
      officers.map((officer, i) => (
        <div
          class="min-w-0 w-full"
          data-officer
          data-types={JSON.stringify(officer.type)}
        >
          <Officer
            name={officer.name}
            position={officer.position}
            picture={resolveOfficerImage(officer.picture)}
            email={officer.email}
            eager={i < eagerCount}
          />
        </div>
      ))
    }
  </div>
</div>
