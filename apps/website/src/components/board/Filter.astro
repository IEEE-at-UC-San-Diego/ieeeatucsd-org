---
interface Props {
  filters: string[];
  currentFilter: string;
}

const { filters, currentFilter }: Props = Astro.props;
---

<div
  class="filter-rail relative flex max-w-full flex-nowrap items-stretch gap-1 overflow-x-auto"
  role="group"
  aria-label="Filter officers by team"
>
  <div
    id="slider"
    class="filter-slider pointer-events-none absolute bottom-0 h-0.5 bg-ieee-yellow"
    style="left: 0px; width: 0px;"
  >
  </div>
  {
    filters.map((filter) => (
      <button
        type="button"
        data-filter={filter}
        aria-pressed={currentFilter === filter ? "true" : "false"}
        class={`relative z-10 inline-flex min-h-[44px] shrink-0 items-center whitespace-nowrap px-3 text-sm font-medium tracking-tight transition-colors sm:px-4 ${
          currentFilter === filter
            ? "text-white"
            : "text-white/55 hover:text-white"
        }`}
      >
        {filter}
      </button>
    ))
  }
</div>

<style>
  .filter-rail {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-rail::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-slider {
      transition:
        left 200ms cubic-bezier(0.23, 1, 0.32, 1),
        width 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll(
    "[data-filter]",
  ) as NodeListOf<HTMLElement>;
  const officers = document.querySelectorAll(
    "[data-officer]",
  ) as NodeListOf<HTMLElement>;
  const slider = document.getElementById("slider") as HTMLElement;

  function moveSlider(button: HTMLElement) {
    if (!slider || !button.parentElement) return;
    const buttonRect = button.getBoundingClientRect();
    const containerRect = button.parentElement.getBoundingClientRect();
    slider.style.width = `${buttonRect.width}px`;
    slider.style.left = `${buttonRect.left - containerRect.left}px`;
  }

  function activeButton() {
    return Array.from(buttons).find(
      (btn) => btn.getAttribute("aria-pressed") === "true",
    );
  }

  function updateFilter(selectedFilter: string, clickedButton: HTMLElement) {
    buttons.forEach((btn) => {
      const isSelected = btn.getAttribute("data-filter") === selectedFilter;
      btn.classList.toggle("text-white", isSelected);
      btn.classList.toggle("text-white/55", !isSelected);
      btn.classList.toggle("hover:text-white", !isSelected);
      btn.setAttribute("aria-pressed", isSelected ? "true" : "false");
    });

    moveSlider(clickedButton);

    officers.forEach((officer) => {
      const types = JSON.parse(officer.getAttribute("data-types") || "[]");
      const match = selectedFilter === "All" || types.includes(selectedFilter);
      officer.toggleAttribute("hidden", !match);
    });
  }

  const initialButton = Array.from(buttons).find(
    (btn) => btn.getAttribute("data-filter") === "All",
  );
  if (initialButton) {
    moveSlider(initialButton);
  }

  // Keep the underline aligned after late font loading or a resize.
  window.addEventListener("resize", () => {
    const active = activeButton();
    if (active) moveSlider(active);
  });

  if (document.fonts?.ready) {
    document.fonts.ready.then(() => {
      const active = activeButton();
      if (active) moveSlider(active);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filterValue = button.getAttribute("data-filter");
      if (filterValue) {
        updateFilter(filterValue, button);
      }
    });
  });
</script>
