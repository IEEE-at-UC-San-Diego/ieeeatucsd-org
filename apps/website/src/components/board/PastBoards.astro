---
import Title from "../core/Title.astro";
import pastBoards from "../../data/pastBoards.json";

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "Past boards",
  description = "Previous IEEE at UC San Diego boards.",
} = Astro.props;
---

<div class="pb-24 sm:pb-32">
  <Title title={heading}>{description}</Title>

  <a href="/board" class="btn-link mt-8 inline-flex text-ieee-blue-100">
    View current board
  </a>

  <ul class="mt-14 border-t border-white/10" data-reveal>
    {
      pastBoards.map((entry) => (
        <li>
          <a
            href={entry.href}
            class="group flex flex-col gap-3 border-b border-white/10 py-8 text-white no-underline transition-colors sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
          >
            <div class="min-w-0">
              <p class="title-3 text-white">{entry.year}</p>
              <p class="copy mt-2 max-w-2xl">{entry.summary}</p>
            </div>
            <span class="btn-link shrink-0 text-ieee-blue-100 transition-colors group-hover:text-ieee-yellow">
              View board
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
