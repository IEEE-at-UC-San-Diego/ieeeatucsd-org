---
import about from "../../images/about.webp";
import { Image } from "astro:assets";
import neko from "../../images/neko.webp";
import pastBoards from "../../data/pastBoards.json";

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "Past boards",
  description = "Previous IEEE at UC San Diego boards.",
} = Astro.props;
---

<div
  class="text-white flex flex-col items-center md:mt-[min(5vw,4.5rem)] mt-[min(10vw,9rem)] mb-[10vh]"
>
  <div class="relative w-[min(40vw,36rem)] md:w-[min(21vw,18.9rem)] mb-[10vh]">
    <Image src={about} alt="About background image" />
    <Image
      src={neko}
      alt="About image"
      class="absolute top-[10%] left-[16%] aspect-[399/491] object-cover w-[min(27vw,24.3rem)] md:w-[min(14vw,12.6rem)] rounded-[min(2vw,1.8rem)]"
    />
  </div>

  <h1 class="font-display font-bold text-[clamp(1.8rem,4vw,2.8rem)] mt-2">
    {heading}
  </h1>

  <p
    class="md:text-[min(1.3vw,1.17rem)] text-[min(2.5vw,2.25rem)] md:w-[56%] w-[70%] my-[3%] font-extralight text-center"
  >
    {description}
  </p>

  <a
    href="/board"
    class="mb-[min(4vw,3.6rem)] text-ieee-yellow md:text-[min(1vw,0.9rem)] text-[min(2.2vw,1.98rem)] underline underline-offset-4 hover:text-white transition-colors"
  >
    View current board
  </a>

  <ul class="w-[80%] md:w-[40%] flex flex-col gap-[min(2vw,1.8rem)]">
    {
      pastBoards.map((entry) => (
        <li>
          <a
            href={entry.href}
            class="group block rounded-[min(1.5vw,1.35rem)] border border-white/10 bg-gradient-to-t from-ieee-blue-100/5 to-ieee-blue-100/25 px-[4%] py-[3%]"
          >
            <p class="md:text-[min(1.8vw,1.62rem)] text-[min(3.6vw,3.24rem)] font-semibold tracking-tight">
              {entry.year}
            </p>
            <p class="md:text-[min(1vw,0.9rem)] text-[min(2.2vw,1.98rem)] font-extralight text-white/80 mt-[min(0.6vw,0.54rem)]">
              {entry.summary}
            </p>
            <p class="mt-[min(1.2vw,1.08rem)] text-ieee-yellow md:text-[min(0.9vw,0.81rem)] text-[min(2vw,1.8rem)] group-hover:text-white transition-colors">
              View board
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</div>
