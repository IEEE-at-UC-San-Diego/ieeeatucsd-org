---
import annualProjects from "../../data/annualProjects.json";
import { Image } from "astro:assets";
---

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-5">
  {
    Object.entries(annualProjects).map(([title, project]) => (
      <a
        href={project.url || "#"}
        target={title === "Supercomputing" ? "_blank" : "_self"}
        rel={title === "Supercomputing" ? "noreferrer" : undefined}
        class="ieee-panel overflow-hidden group flex flex-col"
      >
        <Image
          src={project.image}
          alt=""
          width={668}
          height={990}
          class="w-full aspect-[2/3] object-cover"
        />
        <div class="p-5 flex flex-col flex-1">
          <h3 class="font-display font-semibold text-xl">{title}</h3>
          <p class="mt-2 text-sm text-white/75 leading-relaxed flex-1">
            {project.description}
          </p>
          <p class="mt-4 text-ieee-yellow text-sm">More details</p>
        </div>
      </a>
    ))
  }
</div>
