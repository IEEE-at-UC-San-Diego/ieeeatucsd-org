---
import { Image } from "astro:assets";
import qp from "../../images/qp.webp";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="qp-heading">
  <SectionHeading id="qp-heading" eyebrow="Ten weeks" title="Quarterly Project" />
  <div class="mt-8 ieee-panel overflow-hidden">
    <Image
      src={qp}
      alt="Students presenting a Quarterly Project"
      class="w-full aspect-[2.5/1] object-cover"
    />
    <div class="p-6 sm:p-8">
      <p class="text-white/80 leading-relaxed max-w-3xl">
        New to hardware, or want a project on your resume? Quarterly Projects
        gives teams ten weeks, mentors, and a public showcase.
      </p>
      <a class="ieee-btn ieee-btn-ghost mt-6" href="/projects/quarterly">
        More details
      </a>
    </div>
  </div>
</section>
