---
// Interactive wireframe Arduino Uno R3. Pure line work, drawn in on load,
// slowly sways, and can be dragged. Falls back to nothing if WebGL is missing.
---

<figure
  class="arduino-stage"
  data-arduino
  role="img"
  aria-label="Interactive wireframe drawing of an Arduino Uno board. Drag to rotate."
>
  <canvas class="arduino-canvas" aria-hidden="true"></canvas>
  <div class="arduino-labels" aria-hidden="true"></div>
  <figcaption class="arduino-caption mono-label">
    <span>Fig. 01</span>
    <span>Arduino Uno R3</span>
    <span class="arduino-hint">Drag to rotate</span>
  </figcaption>
</figure>

<style is:global>
  .arduino-stage {
    position: relative;
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 22rem;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .arduino-stage.is-dragging {
    cursor: grabbing;
  }

  .arduino-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .arduino-labels {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bp-label {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-ibm-plex-mono), ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(214, 234, 248, 0.82);
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 600ms ease;
  }

  .bp-label::before {
    content: "";
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .bp-label.is-flipped {
    flex-direction: row-reverse;
  }

  .bp-label[data-accent="true"] {
    color: #f3c135;
  }

  .bp-label[data-dim="true"] {
    padding: 0.15rem 0.5rem;
    background: #0a0e1a;
    color: rgba(214, 234, 248, 0.6);
  }

  .bp-label[data-dim="true"]::before {
    display: none;
  }

  .arduino-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    pointer-events: none;
  }

  .arduino-caption span:first-child {
    color: #88bfec;
  }

  .arduino-stage[data-state="fallback"] .arduino-caption,
  .arduino-stage[data-state="fallback"] .arduino-canvas {
    display: none;
  }

  @media (hover: none) {
    .arduino-hint {
      display: none;
    }
  }
</style>

<script>
  import {
    MathUtils,
    PerspectiveCamera,
    Scene,
    WebGLRenderer,
    Group,
    Vector3,
  } from "three";
  import {
    buildArduino,
    LINE_WIDTHS,
    type LineKind,
  } from "../../lib/arduino-model";

  const KINDS: LineKind[] = ["board", "trace", "part", "accent", "dim"];
  const FOV = 24;
  const ELEVATION = MathUtils.degToRad(34);
  const easeOut = (t: number) => 1 - Math.pow(1 - MathUtils.clamp(t, 0, 1), 3);

  function init(stage: HTMLElement) {
    const canvas = stage.querySelector<HTMLCanvasElement>(".arduino-canvas")!;
    const labelHost = stage.querySelector<HTMLElement>(".arduino-labels")!;

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "high-performance",
      });
    } catch {
      stage.dataset.state = "fallback";
      return;
    }
    renderer.setClearColor(0x000000, 0);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const scene = new Scene();
    const camera = new PerspectiveCamera(FOV, 1, 1, 1000);
    const shift = new Group();
    const model = buildArduino();
    shift.add(model.root);
    scene.add(shift);

    // DOM labels, positioned by projecting their 3D anchors every frame
    const labels = model.labels.map((l) => {
      const el = document.createElement("span");
      el.className = "bp-label";
      el.textContent = l.text;
      if (l.accent) el.dataset.accent = "true";
      if (l.id.startsWith("dim-")) el.dataset.dim = "true";
      labelHost.appendChild(el);
      return { ...l, el };
    });

    let width = 1;
    let height = 1;
    let dpr = 1;
    let distance = 150;

    function resize() {
      width = Math.max(stage.clientWidth, 1);
      height = Math.max(stage.clientHeight, 1);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(dpr);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;

      const tanH = Math.tan(MathUtils.degToRad(FOV / 2));
      distance = Math.max(64 / (tanH * camera.aspect), 35 / tanH);
      camera.position.set(
        0,
        Math.sin(ELEVATION) * distance,
        Math.cos(ELEVATION) * distance,
      );
      camera.lookAt(0, 0, 0);
      camera.near = distance - 120;
      camera.far = distance + 120;
      camera.updateProjectionMatrix();
      // asymmetric margin: dimension lines hang off the left edge
      shift.position.x = 9;

      for (const kind of KINDS) {
        const u = model.materials[kind].uniforms;
        u.uRes.value.set(width * dpr, height * dpr);
        u.uWidth.value = LINE_WIDTHS[kind] * dpr;
        u.uNear.value = distance - 46;
        u.uFar.value = distance + 46;
      }
      for (const l of labels) {
        l.el.hidden = width < (l.minWidth ?? 0);
      }
      measureLabels();
      renderOnce();
    }

    // Label widths are cached so the per-frame loop never forces layout.
    const widths = new Map<string, number>();
    function measureLabels() {
      for (const l of labels) widths.set(l.id, l.el.offsetWidth);
    }
    document.fonts?.ready.then(measureLabels);

    /* ---- interaction: click and hold to rotate; hovering does nothing ---- */
    let dragYaw = 0;
    let dragPitch = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      stage.classList.add("is-dragging");
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      dragYaw += (e.clientX - lastX) * 0.01;
      dragPitch = MathUtils.clamp(
        dragPitch + (e.clientY - lastY) * 0.006,
        -0.7,
        0.6,
      );
      lastX = e.clientX;
      lastY = e.clientY;
      if (reduceMotion.matches) renderOnce();
    });
    const endDrag = () => {
      dragging = false;
      stage.classList.remove("is-dragging");
    };
    stage.addEventListener("pointerup", endDrag);
    stage.addEventListener("pointercancel", endDrag);
    stage.addEventListener("lostpointercapture", endDrag);

    /* ---- render loop ---- */
    const start = performance.now();
    let lastNow = start;
    let swayPhase = 0;
    const v = new Vector3();
    let visible = true;
    let raf = 0;

    function frame(now: number) {
      const t = reduceMotion.matches ? 99 : (now - start) / 1000;

      // plotter-style draw-in
      for (const kind of KINDS) {
        const [a, b] = model.schedule[kind];
        model.materials[kind].uniforms.uProgress.value = easeOut(
          (t - a) / (b - a),
        );
      }

      // idle sway pauses while the user holds the model, then resumes in place
      const dt = Math.min((now - lastNow) / 1000, 0.1);
      lastNow = now;
      if (!dragging && !reduceMotion.matches) swayPhase += dt * 0.32;
      const sway = Math.sin(swayPhase) * 0.34;
      model.root.rotation.y = -0.5 + sway + dragYaw;
      model.root.rotation.x = dragPitch;
      model.root.rotation.z = 0;

      renderer.render(scene, camera);

      // labels
      scene.updateMatrixWorld();
      labels.forEach((l, i) => {
        if (l.el.hidden) return;
        l.anchor.getWorldPosition(v);
        v.project(camera);
        const x = (v.x * 0.5 + 0.5) * width;
        const y = (-v.y * 0.5 + 0.5) * height;
        const isDim = l.id.startsWith("dim-");
        // flip callouts to the left of their anchor when they would clip
        const flip = !isDim && x + (widths.get(l.id) ?? 0) > width - 4;
        l.el.classList.toggle("is-flipped", flip);
        const anchorShift = isDim
          ? "translate(-50%, -50%)"
          : flip
            ? "translate(-100%, -50%)"
            : "translateY(-50%)";
        l.el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) ${anchorShift}`;
        l.el.style.opacity = t > 2.3 + i * 0.07 ? "1" : "0";
      });
    }

    function loop(now: number) {
      frame(now);
      raf = requestAnimationFrame(loop);
    }

    function renderOnce() {
      if (reduceMotion.matches) frame(performance.now());
    }

    function setRunning(run: boolean) {
      if (reduceMotion.matches) return;
      if (run && !raf) raf = requestAnimationFrame(loop);
      if (!run && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    new ResizeObserver(resize).observe(stage);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        setRunning(visible && !document.hidden);
      },
      { threshold: 0 },
    ).observe(stage);
    document.addEventListener("visibilitychange", () =>
      setRunning(visible && !document.hidden),
    );
    reduceMotion.addEventListener("change", () => {
      setRunning(visible && !document.hidden);
      renderOnce();
    });

    resize();
    setRunning(true);
    stage.dataset.state = "ready";
  }

  document
    .querySelectorAll<HTMLElement>("[data-arduino]")
    .forEach((stage) => init(stage));
</script>
