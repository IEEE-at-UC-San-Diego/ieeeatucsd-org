---
import ArduinoModel from "./ArduinoModel.astro";
---

<section
  class="relative pt-4 pb-10 md:pt-8 md:pb-16"
  aria-labelledby="home-heading"
>
  <div
    class="bp-grid grid items-center gap-2 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-6"
  >
    <div class="relative z-10 pt-10 lg:py-20">
      <h1
        id="home-heading"
        class="display text-[clamp(2.5rem,4.9vw,4.9rem)]"
        data-reveal
        style="--reveal-delay: 70ms"
      >
        Join one of the largest IEEE student branches in the US!
      </h1>
      <p class="lead mt-7 max-w-xl" data-reveal style="--reveal-delay: 150ms">
        IEEE @ UCSD is a pre-professional organization aiming to empower
        engineers with practical experience through hands-on project
        opportunities, insightful workshops, and panels with industry
        professionals. We are a branch of the International IEEE organization.
      </p>
      <div
        class="mt-10 flex flex-wrap items-center gap-3"
        data-reveal
        style="--reveal-delay: 230ms"
      >
        <a class="ieee-btn ieee-btn-primary" href="/join">Join the club</a>
        <a class="ieee-btn ieee-btn-ghost" href="/join#project-space">
          Visit Project Space
        </a>
      </div>
    </div>

    <div
      class="relative overflow-visible h-[29rem] sm:h-[36rem] lg:h-[47rem] lg:-mr-10 xl:-mr-16"
    >
      <ArduinoModel />
    </div>
  </div>
</section>
