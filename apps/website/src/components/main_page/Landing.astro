---
import { Image } from "astro:assets";
import landingimg from "../../images/landing.webp";
---

<section
  class="page-section pt-8 md:pt-12"
  aria-labelledby="home-heading"
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] items-stretch">
    <div class="ieee-panel p-6 sm:p-8 lg:p-10 flex flex-col">
      <p class="eyebrow text-ieee-yellow text-xs md:text-sm mb-4">
        UC San Diego IEEE
      </p>
      <h1
        id="home-heading"
        class="font-display font-bold text-[clamp(1.9rem,4.4vw,3.4rem)]"
      >
        A student branch built around a real studio
      </h1>
      <p class="mt-5 text-lead text-white/80 max-w-xl">
        IEEE at UC San Diego is one of the largest IEEE student branches in the
        country. We run projects, workshops, and industry panels — and we keep
        Project Space open so you can walk in and start.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="ieee-btn ieee-btn-primary" href="/join">Join the club</a>
        <a class="ieee-btn ieee-btn-ghost" href="/join#project-space">
          Visit Project Space
        </a>
      </div>
    </div>
    <div class="ieee-panel overflow-hidden min-h-[16rem]">
      <Image
        src={landingimg}
        alt="Circuit board artwork for IEEE at UC San Diego"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>
