---
import { Image } from "astro:assets";
import landingimg from "../../images/landing.webp";
import { FaDiscord } from "react-icons/fa";
import { RiInstagramFill } from "react-icons/ri";
import { MdEmail } from "react-icons/md";
---

<div class="w-full flex justify-between space-x-2 pt-[2%]">
  <div
    class="md:pt-[5%] pt-[6%] bg-gradient-to-t to-ieee-blue-100/30 p-[5vw] via-ieee-black from-ieee-black md:w-[53%] w-[60%] md:h-[45vw] h-[65vw] border-white/15 border-[0.1vw] rounded-[3vw] shadow-2xl shadow-ieee-blue-300/20 ring-1 ring-inset ring-white/5"
  >
    <p
      data-inview
      class="eyebrow animate-ease-in-out text-ieee-yellow text-[2.4vw] md:text-[1.05vw] mb-[4%] in-view:animate-flip-down"
    >
      UC San Diego IEEE
    </p>
    <p
      data-inview
      class="font-display animate-ease-in-out font-bold text-[3.8vw] md:text-[2.9vw] text-white mb-[6%] in-view:animate-fade-right"
    >
      Join one of the largest IEEE student branches in the US!
    </p>
    <p class="text-white font-light text-[2vw] md:text-[1.3vw]">
      IEEE @ UCSD is a pre-professional organization aiming to empower engineers
      with practical experience through hands-on project opportunities,
      insightful workshops, and panels with industry professionals. We are a
      branch of the International IEEE organization.
    </p>

    <div class="flex justify-end w-full mt-[6%]">
      <div
        class="text-white text-[3.5vw] md:text-[2.5vw] w-1/2 flex justify-between"
      >
        <a
          href="https://www.instagram.com/ieee.at.ucsd"
          target="_blank"
          class="border-[0.15vw] border-white/60 rounded-full p-[5%] shadow-glow hover:scale-110 hover:border-ieee-blue-100 hover:text-ieee-blue-100 transition-all ease-out duration-300"
        >
          <RiInstagramFill />
        </a>
        <a
          href="https://discord.gg/XxfjqZSjca"
          target="_blank"
          class="border-[0.15vw] border-white/60 rounded-full p-[5%] shadow-glow hover:scale-110 hover:border-ieee-blue-100 hover:text-ieee-blue-100 transition-all ease-out duration-300"
        >
          <FaDiscord />
        </a>

        <a
          href="mailto:ieee@ucsd.edu"
          target="_blank"
          class="border-[0.15vw] border-white/60 rounded-full p-[5%] shadow-glow hover:scale-110 hover:border-ieee-blue-100 hover:text-ieee-blue-100 transition-all ease-out duration-300"
        >
          <MdEmail />
        </a>
      </div>
    </div>
  </div>
  <div
    class="md:w-[46%] w-[40%] md:h-[45vw] h-[65vw] border-white/15 border-[0.1vw] rounded-[3vw] bg-gradient-to-b to-ieee-blue-100/60 from-ieee-black shadow-2xl shadow-ieee-blue-300/20 ring-1 ring-inset ring-white/5 overflow-hidden"
  >
    <Image
      src={landingimg}
      alt="circuit"
      class="w-[95%] md:h-[45vw] h-[60vw] object-contain"
    />
  </div>
</div>
