---
import { IoIosArrowDroprightCircle } from "react-icons/io";
const { title, text, link, number, delay } = Astro.props;
---

<div
  data-inview
  class={`group animate-ease-in-out relative text-white flex flex-col items-center w-[30vw] md:w-[17vw] bg-gradient-to-b from-ieee-blue-100/40 to-ieee-black md:h-[33vw] h-[40vw] border-[0.1vw] border-white/15 rounded-[2vw] md:pt-[5%] pt-[15%] pb-[3%] in-view:animate-fade-down duration-500 animate-delay-${delay} shadow-xl shadow-ieee-black/40 ring-1 ring-inset ring-white/5 transition-[transform,box-shadow,border-color] ease-out hover:-translate-y-2 hover:border-ieee-blue-100/50 hover:shadow-2xl hover:shadow-ieee-blue-300/30`}
>
  <div
    class="rounded-full aspect-square w-[7vw] md:w-[5.5vw] absolute bg-gradient-to-b from-ieee-blue-100 to-ieee-blue-300 -top-[10%] shadow-xl shadow-ieee-blue-300 ring-1 ring-white/20 transition-transform duration-500 ease-out group-hover:scale-110"
  >
  </div>
  <p class="font-display text-[2.7vw] md:text-[1.7vw] font-bold tracking-tight text-center">
    {title}
  </p>
  <p
    class={`text-[1.7vw] md:text-[1.2vw] w-4/5 ${title === "Professional Development" ? "md:mt-[2%] mt-[2%]" : "md:mt-[15%] mt-[5%]"}`}
  >
    {text}
  </p>

  <a
    href={link}
    class="flex items-center text-[2vw] md:text-[1.2vw] mb-[3%] absolute md:bottom-[22%] bottom-[25%] hover:text-ieee-yellow duration-300"
  >
    more details
    <IoIosArrowDroprightCircle
      className="ml-[0.5vw] text-[2vw] md:text-[1.4vw]"
    />
  </a>
  <p
    data-numeric
    class="font-display text-[7vw] md:text-[3.7vw] font-extrabold tracking-tight text-ieee-blue-300/50 absolute bottom-[5%]"
  >
    {number}
  </p>
</div>
