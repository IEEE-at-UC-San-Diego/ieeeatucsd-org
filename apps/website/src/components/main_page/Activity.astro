---
const { title, text, link } = Astro.props;
---

<article class="ieee-panel p-6 flex flex-col h-full">
  <h3 class="font-display font-semibold text-xl md:text-2xl">{title}</h3>
  <p class="mt-3 text-white/75 leading-relaxed flex-1">{text}</p>
  <a class="ieee-btn ieee-btn-ghost mt-6 self-start" href={link}>
    More details
  </a>
</article>
