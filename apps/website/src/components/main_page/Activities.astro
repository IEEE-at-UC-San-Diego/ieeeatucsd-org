---
import Activity from "./Activity.astro";
import activities from "../../data/activities.json";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="activities-heading">
  <SectionHeading id="activities-heading" title="Events and projects">
    Involvement can follow your schedule, interests, and professional goals.
  </SectionHeading>

  <ol class="mt-14 border-b border-white/10 md:mt-20">
    {
      activities.map((activity, index) => (
        <Activity
          index={index + 1}
          title={activity.title}
          text={activity.text}
          link={activity.link}
        />
      ))
    }
  </ol>
</section>
