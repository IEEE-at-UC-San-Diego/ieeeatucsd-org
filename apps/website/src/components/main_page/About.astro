---
import about4 from "../../images/about4.webp";
import { Image } from "astro:assets";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="about-heading">
  <div class="grid gap-8 lg:grid-cols-2 items-center">
    <div class="ieee-panel overflow-hidden">
      <Image
        src={about4}
        alt="IEEE at UC San Diego members working together"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
    <div>
      <SectionHeading id="about-heading" title="About IEEE at UC San Diego" />
      <p class="mt-5 text-white/80 leading-relaxed">
        A diverse engineering community seeking to empower students through
        hands-on projects, networking opportunities, and social events. Bonus
        points on having an open-access project studio!
      </p>
      <p class="mt-4 text-white/80 leading-relaxed">
        The IEEE UC San Diego student branch is part of the world’s largest
        technical professional organization. On campus we are consistently one
        of the largest student branches in the United States — including a 2nd
        Largest Student Branch Award in 2021 and 2022.
      </p>
      <a class="ieee-btn ieee-btn-ghost mt-8" href="/join">Learn more</a>
    </div>
  </div>
</section>
