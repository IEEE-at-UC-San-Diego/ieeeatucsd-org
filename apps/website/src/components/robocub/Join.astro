---
import { GoArrowDownRight } from "react-icons/go";
import { Image } from "astro:assets";
import robocup from "../../images/robocup.webp";
---

<section class="page-section">
  <a
    href="https://docs.google.com/forms/d/e/1FAIpQLSex5VejEiClvgcfhSBQJ9IH5Q008j-HWC5Y9YAa56yIHgGBvw/viewform?usp=sf_link"
    target="_blank"
    class="group grid items-center gap-10 no-underline md:grid-cols-12 md:gap-12"
  >
    <div class="md:col-span-5">
      <h2 class="display text-white">We Are<br />Hiring</h2>
      <div class="copy mt-6 max-w-xl">
        <p>
          Join a community of novice to experienced engineers from a wide range
          of disciplines and backgrounds.
        </p>
        <p class="mt-3">
          Fill out this application form (due week 2 of each quarter if space
          permits)
        </p>
      </div>
      <span
        class="mt-8 inline-flex w-fit items-center gap-2 text-ieee-blue-100 transition-colors duration-200 group-hover:text-ieee-yellow"
      >
        Application form
        <GoArrowDownRight
          className="text-xl transition duration-300 group-hover:translate-x-1 group-hover:translate-y-1"
        />
      </span>
    </div>

    <div class="md:col-span-7">
      <div
        class="overflow-hidden rounded-[28px] border border-ieee-blue-100/15"
      >
        <Image
          src={robocup}
          alt="robocub competition image"
          class="aspect-[16/10] w-full object-cover"
        />
      </div>
    </div>
  </a>
</section>
