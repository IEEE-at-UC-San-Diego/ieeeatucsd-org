---
import Subtitle from "../core/Subtitle.astro";
import subteams from "../../data/subteams.json";
import { FaGear, FaMicrochip, FaCode } from "react-icons/fa6";
import { LuBrainCircuit } from "react-icons/lu";
---

<div class="relative my-16 flex flex-col items-center md:my-24">
  <Subtitle title="Subteams" />
  <div class="grid w-full max-w-3xl grid-cols-1 gap-10 sm:grid-cols-2">
    {
      subteams.map((subteam) => (
        <div class="relative pt-8">
          <div class="absolute left-1/2 top-0 z-10 w-fit -translate-x-1/2 rounded-full bg-gradient-to-b from-ieee-blue-100 to-ieee-blue-300 p-3 text-2xl shadow-ieee-blue-300 md:text-3xl">
            {subteam.title === "Mechanical" && <FaGear />}
            {subteam.title === "Electrical" && <FaMicrochip />}
            {subteam.title === "AI" && <LuBrainCircuit />}
            {subteam.title === "Embedded" && <FaCode />}
          </div>
          <div class="flex h-full flex-col rounded-2xl border border-white/40 bg-gradient-to-b from-ieee-blue-100/25 to-ieee-black px-6 pb-6 pt-12 text-center backdrop-blur">
            <p class="mb-3 text-base font-semibold md:text-lg">
              {subteam.title}
            </p>
            <ul class="space-y-2 text-left text-sm font-light leading-relaxed md:text-base">
              {subteam.list.map((item: string) => (
                <li>&#8226; {item}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</div>
