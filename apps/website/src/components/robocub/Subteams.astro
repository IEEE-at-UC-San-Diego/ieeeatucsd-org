---
import SectionHeading from "../core/SectionHeading.astro";
import subteams from "../../data/subteams.json";
---

<section class="page-section" aria-labelledby="subteams-heading">
  <SectionHeading id="subteams-heading" title="Subteams" />
  <ul
    class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 md:grid-cols-2 md:gap-x-16 md:gap-y-16"
  >
    {
      subteams.map((subteam, index) => (
        <li data-reveal style={`--reveal-delay: ${index * 60}ms`}>
          <div class="flex items-baseline justify-between gap-4 border-t border-white/10 pt-5">
            <h3 class="title-3 text-white">{subteam.title}</h3>
            <span class="font-mono-tech text-xs text-ieee-blue-100/70">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <ul class="mt-5 space-y-3">
            {subteam.list.map((item: string) => (
              <li class="copy flex gap-3">
                <span
                  aria-hidden="true"
                  class="mt-[0.62em] h-[3px] w-[3px] shrink-0 bg-ieee-blue-100/70"
                />
                <span class="max-w-[46ch]">{item}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
