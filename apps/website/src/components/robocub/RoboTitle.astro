---
import { Image } from "astro:assets";
import background from "../../images/robocup_bg.jpeg";
import roboLogo from "../../images/triton_bots_logo.png";
---

<div
  class="flex items-center md:h-[35cqw] h-[45cqw] relative w-full pl-[10%] md:mt-[3%] mt-[10%] mb-[10%]"
>
  <Image
    src={background}
    alt="Robocup Background"
    class="absolute left-1/2 -translate-x-1/2 w-screen top-0 opacity-90 h-[40cqw] object-cover"
  />
  <div
    class="absolute left-1/2 -translate-x-1/2 w-screen top-0 h-[40cqw] bg-gradient-to-r from-ieee-black via-ieee-black/80"
  >
  </div>
  <div
    class="z-10 flex items-center md:text-[4cqw] text-[4.5cqw] ml-[7%] md:pt-[5%] pt-[10%] text-white font-semibold"
  >
    <Image
      src={roboLogo}
      alt="Triton RoboCup Team Logo"
      class="mr-[1cqw] w-[10cqw]"
    />
    <div class="flex flex-col">
      <p>TritonBots RoboCup SSL Team</p>
      <div class="-mt-[2cqw]">
        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLSdigg2WPFvAGwaeY_i7uTEPkDplRUkPFb3w5SJLEQeZYNviXw/viewform?usp=sharing&ouid=108575348199269065111"
          target="_blank"
          class="md:text-[1.2cqw] text-[2cqw] font-light border-white/70 border-[0.1cqw] py-[1.5%] px-[10%] rounded-[0.5cqw] hover:text-ieee-yellow hover:border-ieee-yellow duration-300"
        >
          Interested? Apply Here
        </a>
      </div>
    </div>
  </div>
</div>
