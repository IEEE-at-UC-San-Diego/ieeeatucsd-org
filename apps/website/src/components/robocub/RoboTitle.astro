---
import { Image } from "astro:assets";
import background from "../../images/robocup_bg.jpeg";
import roboLogo from "../../images/triton_bots_logo.png";
---

<div
  class="flex items-center md:h-[min(35vw,31.5rem)] h-[min(45vw,40.5rem)] relative w-full pl-[10%] md:mt-[3%] mt-[10%] mb-[10%]"
>
  <Image
    src={background}
    alt="Robocup Background"
    class="absolute w-screen right-0 top-0 opacity-90 h-[min(40vw,36rem)]"
  />
  <div
    class="absolute w-screen right-0 top-0 h-[min(40vw,36rem)] bg-gradient-to-r from-ieee-black via-ieee-black/80"
  >
  </div>
  <div
    class="z-10 flex items-center md:text-[min(4vw,3.6rem)] text-[min(4.5vw,4.05rem)] ml-[7%] md:pt-[5%] pt-[10%] text-white font-semibold"
  >
    <Image
      src={roboLogo}
      alt="Triton RoboCup Team Logo"
      class="mr-[min(1vw,0.9rem)] w-[min(10vw,9rem)]"
    />
    <div class="flex flex-col">
      <p>TritonBots RoboCup SSL Team</p>
      <div class="-mt-[min(2vw,1.8rem)]">
        <a
          class="text-[min(1.2vw,1.08rem)]"
          href="https://docs.google.com/forms/d/e/1FAIpQLSdigg2WPFvAGwaeY_i7uTEPkDplRUkPFb3w5SJLEQeZYNviXw/viewform?usp=sharing&ouid=108575348199269065111"
          target="_blank"
          class="md:text-[min(1.2vw,1.08rem)] text-[min(2vw,1.8rem)] font-light border-white/70 border-[min(0.1vw,0.09rem)] py-[1.5%] px-[10%] rounded-[min(0.5vw,0.45rem)] hover:text-ieee-yellow hover:border-ieee-yellow duration-300"
        >
          Interested? Apply Here
        </a>
      </div>
    </div>
  </div>
</div>
