---
import { Image } from "astro:assets";
import background from "../../images/robocup_bg.jpeg";
import roboLogo from "../../images/triton_bots_logo.png";
---

<header
  class="relative isolate mt-6 mb-4 overflow-hidden rounded-[28px] border border-ieee-blue-100/15 md:mt-10 md:mb-8"
>
  <Image
    src={background}
    alt="Robocup Background"
    class="absolute inset-0 h-full w-full object-cover opacity-80"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-ieee-black via-ieee-black/85 to-ieee-black/30"
  >
  </div>
  <div
    class="relative z-10 flex min-h-[clamp(16rem,38vw,26rem)] flex-col justify-end gap-6 p-6 md:p-12"
  >
    <div class="flex items-center gap-4 md:gap-6">
      <Image
        src={roboLogo}
        alt="Triton RoboCup Team Logo"
        class="w-14 shrink-0 md:w-20"
      />
      <p class="eyebrow">RoboCup Small-Size League</p>
    </div>
    <h1 class="display max-w-4xl text-white">TritonBots RoboCup SSL Team</h1>
    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLSdigg2WPFvAGwaeY_i7uTEPkDplRUkPFb3w5SJLEQeZYNviXw/viewform?usp=sharing&ouid=108575348199269065111"
      target="_blank"
      class="ieee-btn ieee-btn-primary w-fit"
    >
      Interested? Apply Here
    </a>
  </div>
</header>
