---
import { Image } from "astro:assets";
const { picture, name, description, link, linktext } = Astro.props;
---

<section class="page-section">
  <div class="grid items-center gap-10 md:grid-cols-12 md:gap-12" data-reveal>
    <div class="md:col-span-5">
      <p class="eyebrow">Competition</p>
      <h2 class="headline mt-6 text-white">{name}</h2>
      <p class="lead mt-6 max-w-[52ch]">{description}</p>
      <a
        href={link}
        target="_blank"
        rel="noreferrer"
        class="ieee-btn ieee-btn-primary mt-8 w-fit"
      >
        {linktext}
      </a>
    </div>

    <div class="md:col-span-7">
      <figure
        class="overflow-hidden rounded-[28px] border border-ieee-blue-100/15"
      >
        <Image
          src={picture}
          alt=""
          class="aspect-[16/10] w-full object-cover"
        />
      </figure>
    </div>
  </div>
</section>
