---
import { LiaDotCircle } from "react-icons/lia";
import { Image } from "astro:assets";
const { picture, name, description, link, linktext } = Astro.props;
---

<section class="relative my-10 overflow-hidden rounded-2xl md:my-14">
  <Image
    src={picture}
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-25"
  />
  <div
    class="relative z-10 flex min-h-[20rem] max-w-3xl flex-col justify-end gap-4 px-6 py-10 sm:px-8 md:min-h-[24rem] md:px-10 md:py-14"
  >
    <div class="flex items-center gap-2 text-2xl font-semibold md:text-3xl">
      <LiaDotCircle className="shrink-0 text-2xl md:text-3xl" />
      <p>Competition</p>
    </div>
    <p class="text-xl font-semibold tracking-wide md:text-2xl">
      {name}
    </p>
    <p class="text-base leading-relaxed text-white/85 md:text-lg">
      {description}
    </p>
    <a
      href={link}
      target="_blank"
      rel="noreferrer"
      class="ieee-btn ieee-btn-ghost w-fit"
    >
      {linktext}
    </a>
  </div>
</section>
