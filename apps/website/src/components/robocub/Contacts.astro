---
import { FaDiscord, FaGlobe } from "react-icons/fa";
---

<section class="page-section" aria-labelledby="contacts-heading">
  <div class="grid gap-8 md:grid-cols-12 md:gap-12">
    <div class="md:col-span-5">
      <h2 id="contacts-heading" class="headline text-white">Contacts</h2>
      <p class="copy mt-4 max-w-md">To stay up to date, join discord server</p>
    </div>

    <div class="md:col-span-6 md:col-start-7">
      <ul class="border-t border-white/10">
        <li>
          <a
            href="https://ieee-ucsd-robocupssl.github.io/TeamWebsite/index.html"
            target="_blank"
            class="group flex items-center justify-between gap-4 border-b border-white/10 py-5 text-white no-underline transition-colors duration-200 hover:text-ieee-yellow"
          >
            <span class="flex items-center gap-3">
              <span class="text-ieee-blue-100">
                <FaGlobe />
              </span>
              Website
            </span>
            <span
              aria-hidden="true"
              class="text-ieee-blue-100 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-ieee-yellow"
            >
              →
            </span>
          </a>
        </li>
        <li>
          <a
            href="https://discord.gg/XxfjqZSjca"
            target="_blank"
            class="group flex items-center justify-between gap-4 border-b border-white/10 py-5 text-white no-underline transition-colors duration-200 hover:text-ieee-yellow"
          >
            <span class="flex items-center gap-3">
              <span class="text-ieee-blue-100">
                <FaDiscord />
              </span>
              Discord
            </span>
            <span
              aria-hidden="true"
              class="text-ieee-blue-100 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-ieee-yellow"
            >
              →
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
