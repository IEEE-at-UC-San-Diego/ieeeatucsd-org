---
import { FaDiscord, FaGlobe } from "react-icons/fa";
import { LiaDotCircle } from "react-icons/lia";
---

<div class="flex justify-center my-[10%]">
  <div class="w-1/2 flex justify-between">
    <div>
      <div
        class="flex items-center md:text-[min(2.5vw,2.25rem)] text-[min(4vw,3.6rem)]"
      >
        <LiaDotCircle className="mr-[min(1vw,0.9rem)] pt-[0.5%]" />
        <p>Contacts</p>
      </div>
      <p
        class="md:text-[min(1.1vw,0.99rem)] text-[min(1.5vw,1.35rem)] ml-[5%] text-nowrap"
      >
        To stay up to date, join discord server
      </p>
    </div>
    <div class="flex">
      <a
        href="https://ieee-ucsd-robocupssl.github.io/TeamWebsite/index.html"
        target="_blank"
        class="mr-[20%] flex flex-col items-center"
      >
        <div
          class="border-[min(0.15vw,0.135rem)] rounded-full shadow-glow hover:scale-110 duration-300 p-[min(1vw,0.9rem)] md:text-[min(2.2vw,1.98rem)] text-[min(3.5vw,3.15rem)] text-ieee-black/80 border-ieee-blue-100 bg-gradient-radial from-white via-white to-white/40"
        >
          <FaGlobe />
        </div>
        <p
          class="md:text-[min(1.3vw,1.17rem)] text-[min(2vw,1.8rem)] font-semibold"
        >
          Website
        </p>
      </a>

      <a
        href="https://discord.gg/XxfjqZSjca"
        target="_blank"
        class="flex flex-col items-center"
      >
        <div
          class="border-[min(0.15vw,0.135rem)] rounded-full shadow-glow hover:scale-110 duration-300 p-[min(1vw,0.9rem)] md:text-[min(2.2vw,1.98rem)] text-[min(3.5vw,3.15rem)] text-ieee-black/80 border-ieee-blue-100 bg-gradient-radial from-white via-white to-white/40"
        >
          <FaDiscord />
        </div>
        <p
          class="md:text-[min(1.3vw,1.17rem)] text-[min(2vw,1.8rem)] font-semibold"
        >
          Discord
        </p>
      </a>
    </div>
  </div>
</div>
