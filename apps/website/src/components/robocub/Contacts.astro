---
import { FaDiscord, FaGlobe } from "react-icons/fa";
import { LiaDotCircle } from "react-icons/lia";
---

<div class="flex justify-center my-[10%]">
  <div class="w-1/2 flex justify-between">
    <div>
      <div class="flex items-center md:text-[2.5cqw] text-[4cqw]">
        <LiaDotCircle className="mr-[1cqw] pt-[0.5%]" />
        <p>Contacts</p>
      </div>
      <p class="md:text-[1.1cqw] text-[1.5cqw] ml-[5%] text-nowrap">
        To stay up to date, join discord server
      </p>
    </div>
    <div class="flex">
      <a
        href="https://ieee-ucsd-robocupssl.github.io/TeamWebsite/index.html"
        target="_blank"
        class="mr-[20%] flex flex-col items-center"
      >
        <div
          class="border-[0.15cqw] rounded-full shadow-glow hover:scale-110 duration-300 p-[1cqw] md:text-[2.2cqw] text-[3.5cqw] text-ieee-black/80 border-ieee-blue-100 bg-gradient-radial from-white via-white to-white/40"
        >
          <FaGlobe />
        </div>
        <p class="md:text-[1.3cqw] text-[2cqw] font-semibold">Website</p>
      </a>

      <a
        href="https://discord.gg/XxfjqZSjca"
        target="_blank"
        class="flex flex-col items-center"
      >
        <div
          class="border-[0.15cqw] rounded-full shadow-glow hover:scale-110 duration-300 p-[1cqw] md:text-[2.2cqw] text-[3.5cqw] text-ieee-black/80 border-ieee-blue-100 bg-gradient-radial from-white via-white to-white/40"
        >
          <FaDiscord />
        </div>
        <p class="md:text-[1.3cqw] text-[2cqw] font-semibold">Discord</p>
      </a>
    </div>
  </div>
</div>
