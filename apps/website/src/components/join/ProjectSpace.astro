---
import OpenAccessCalendar from "./OpenAccessCalendar.tsx";
import { OAH_CALENDAR_PAGE_URL } from "../../config/oah";
interface Props {
  showCalendar?: boolean;
}

const { showCalendar = true } = Astro.props;

const mapSrc =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3350.627565860723!2d-117.23806952372503!3d32.881572078634505!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dc06c3689b4f99%3A0xdf55f97f07f34d4f!2sIrwin%20%26%20Joan%20Jacobs%20School%20of%20Engineering!5e0!3m2!1sen!2sus!4v1736755644414!5m2!1sen!2sus";
const calendarSrc = OAH_CALENDAR_PAGE_URL;
const directionsHref = "https://maps.app.goo.gl/y4RwNCkoKBEHGHsv6";

const directions = [
  "Take the Jacobs Hall / EBU1 elevators to the 4th floor.",
  "Turn left after you exit, then walk to the end of the hall.",
  "Project Space is the last hallway on your left.",
];

const tools = [
  "Soldering stations",
  "Breadboards and components",
  "Arduino and Raspberry Pi parts",
  "Open tables for homework",
];
---

<section
  id="project-space"
  class="page-section scroll-mt-24"
  aria-labelledby="project-space-heading"
>
  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-stretch lg:gap-14"
  >
    <div data-reveal>
      <h2 id="project-space-heading" class="headline text-white">
        Project Space
      </h2>
      <p class="mono-label mt-4 text-ieee-blue-100">
        EBU1-4710 · Jacobs Hall, 4th floor
      </p>
      <p class="lead mt-6 max-w-xl">
        The IEEE Project Space is an open-access, collaborative space located at
        EBU1-4710. Students can do homework or get access to basic electronic
        tools such as soldering stations, breadboard components, and Arduino and
        Raspberry PI parts!
      </p>

      <div class="mt-10">
        <p class="mono-label">Directions</p>
        <ol class="mt-4 border-t border-ieee-blue-100/15">
          {
            directions.map((step, i) => (
              <li class="flex gap-5 border-b border-ieee-blue-100/15 py-4">
                <span class="pt-1 font-mono-tech text-xs text-ieee-blue-100/70">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="text-white/80">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-10">
        <p class="mono-label">Tools</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {tools.map((tool) => <li class="chip">{tool}</li>)}
        </ul>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          class="ieee-btn ieee-btn-primary"
          href={directionsHref}
          target="_blank"
          rel="noreferrer"
        >
          Get directions
        </a>
        {
          showCalendar && (
            <a class="ieee-btn ieee-btn-ghost" href="#open-access-hours">
              Officer hours
            </a>
          )
        }
      </div>
    </div>

    <div
      class="surface h-full min-h-[22rem] overflow-hidden"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      <iframe
        class="h-full min-h-[22rem] w-full border-0"
        src={mapSrc}
        title="Map of Jacobs School of Engineering, home of IEEE Project Space"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>

  {
    showCalendar && (
      <div
        id="open-access-hours"
        class="mt-16 scroll-mt-24 md:mt-24"
        data-reveal
      >
        <div class="max-w-3xl">
          <h3 class="title-3 text-white">Open Access Hours</h3>
          <p class="copy mt-3">
            Officers host drop-in hours in Project Space. Use the calendar to
            see who is there and when.
          </p>
        </div>
        <div class="mt-8 min-h-[34rem]">
          <OpenAccessCalendar client:only="react" calendarUrl={calendarSrc} />
        </div>
      </div>
    )
  }
</section>
