---
import Involvement from "./Involvement.astro";
import involve from "../../data/involve.json";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="involve-heading">
  <SectionHeading
    id="involve-heading"
    eyebrow="After you walk in"
    title="Ways to get involved"
  >
    Projects, events, and H.A.R.D. Hack. Pick what fits this quarter.
  </SectionHeading>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
    {
      involve.map((item) => (
        <Involvement text={item.text} image={item.image} link={item.link} />
      ))
    }
  </div>
</section>
