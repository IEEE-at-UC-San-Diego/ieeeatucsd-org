---
import Involvement from "./Involvement.astro";
import involve from "../../data/involve.json";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="involve-heading">
  <SectionHeading id="involve-heading" title="Ways to get involved">
    Projects, events, and H.A.R.D. Hack. Pick what fits this quarter.
  </SectionHeading>

  <div class="mt-12 border-t border-ieee-blue-100/12 md:mt-16">
    {
      involve.map((item, index) => (
        <div class="border-b border-ieee-blue-100/12" data-reveal>
          <Involvement
            text={item.text}
            image={item.image}
            link={item.link}
            index={String(index + 1).padStart(2, "0")}
            reverse={index % 2 === 1}
          />
        </div>
      ))
    }
  </div>
</section>
