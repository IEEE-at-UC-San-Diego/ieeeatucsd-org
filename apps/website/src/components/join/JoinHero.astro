---
const discordHref = "https://discord.gg/XxfjqZSjca";
---

<section class="page-section pt-10 md:pt-16" aria-labelledby="join-heading">
  <p class="eyebrow text-ieee-yellow text-xs md:text-sm mb-4">Get involved</p>
  <h1
    id="join-heading"
    class="font-display font-bold text-[clamp(2.2rem,6vw,4.2rem)] max-w-4xl"
  >
    Join IEEE at UC San Diego
  </h1>
  <p class="mt-5 text-lead text-white/80 max-w-2xl">
    All majors are welcome. There is no membership fee. Start with Discord, then
    walk into Project Space — the open studio on the 4th floor of Jacobs Hall.
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      class="ieee-btn ieee-btn-primary"
      href={discordHref}
      target="_blank"
      rel="noreferrer"
    >
      Join Discord
    </a>
    <a class="ieee-btn ieee-btn-ghost" href="#project-space">
      Visit Project Space
    </a>
  </div>
</section>
