---
const discordHref = "https://discord.gg/XxfjqZSjca";
---

<section class="page-hero bp-grid" aria-labelledby="join-heading">
  <p class="eyebrow" data-reveal>Get involved</p>
  <h1
    id="join-heading"
    class="display mt-6 max-w-5xl"
    data-reveal
    style="--reveal-delay: 60ms"
  >
    Join IEEE at UC San Diego
  </h1>
  <p class="lead mt-6 max-w-2xl" data-reveal style="--reveal-delay: 140ms">
    Just pull up to one of our <a href="/events">events</a>, join one of our <a
      href="/projects">projects</a
    >, or walk in to our <a href="#project-space">project space</a>.
  </p>
  <div
    class="mt-9 flex flex-wrap gap-3"
    data-reveal
    style="--reveal-delay: 220ms"
  >
    <a
      class="ieee-btn ieee-btn-primary"
      href={discordHref}
      target="_blank"
      rel="noreferrer"
    >
      Join Discord
    </a>
    <a class="ieee-btn ieee-btn-ghost" href="#project-space">
      Visit Project Space
    </a>
  </div>
</section>
