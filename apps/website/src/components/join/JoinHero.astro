---
const discordHref = "https://discord.gg/XxfjqZSjca";
---

<section class="page-section pt-10 md:pt-16" aria-labelledby="join-heading">
  <h1
    id="join-heading"
    class="font-display font-bold text-[clamp(2.2rem,6vw,4.2rem)] max-w-4xl"
  >
    Join IEEE at UC San Diego
  </h1>
  <p class="mt-5 text-lead text-white/80 max-w-2xl">
    Just pull up to one of our <a href="/events">events</a>, join one of our <a
      href="/projects">projects</a
    >, or walk in to our <a href="#project-space">project space</a>.
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      class="ieee-btn ieee-btn-primary"
      href={discordHref}
      target="_blank"
      rel="noreferrer"
    >
      Join Discord
    </a>
    <a class="ieee-btn ieee-btn-ghost" href="#project-space">
      Visit Project Space
    </a>
  </div>
</section>
