---
import { GoArrowDownRight } from "react-icons/go";
import { FaGear } from "react-icons/fa6";
import { IoMdCalendar } from "react-icons/io";
import { RiRobot2Fill } from "react-icons/ri";
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";

const { image, text, link } = Astro.props;
const resolvedImage = resolveImage(image);
const isExternal = text === "H.A.R.D. HACK";
---

<a
  href={link}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noreferrer" : undefined}
  class="group relative block overflow-hidden rounded-2xl border border-white/12 bg-ieee-black"
>
  <Image
    src={resolvedImage}
    alt=""
    class="aspect-[3/4] w-full object-cover opacity-70"
  />
  <div
    class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent"
  >
  </div>
  <div class="absolute top-3 right-3 rounded-full bg-white p-2 text-ieee-black">
    {
      text === "PROJECTS" ? (
        <RiRobot2Fill aria-hidden="true" />
      ) : text === "EVENTS" ? (
        <IoMdCalendar aria-hidden="true" />
      ) : (
        <FaGear aria-hidden="true" />
      )
    }
  </div>
  <div class="absolute inset-x-0 bottom-0 p-4">
    <div class="flex items-end justify-between gap-3">
      <p
        class="rounded-full border border-white/70 px-3 py-1 text-sm font-medium"
      >
        {text}
      </p>
      <GoArrowDownRight className="text-2xl" aria-hidden="true" />
    </div>
    {
      isExternal && (
        <p class="mt-3 text-sm text-white/80">
          UC San Diego’s largest hardware-focused hackathon, hosted with HKN and
          TNT.
        </p>
      )
    }
  </div>
</a>
