---
import { GoArrowDownRight } from "react-icons/go";
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";

interface Props {
  image: string;
  text: string;
  link: string;
  index?: string;
  reverse?: boolean;
}

const { image, text, link, index, reverse = false } = Astro.props;
const resolvedImage = resolveImage(image);
const isExternal = text === "H.A.R.D. HACK";
---

<a
  href={link}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noreferrer" : undefined}
  class="group grid items-center gap-6 py-10 md:grid-cols-2 md:gap-14 md:py-14"
>
  <div
    class:list={[
      "surface overflow-hidden transition-colors duration-300 group-hover:border-ieee-blue-100/40",
      reverse && "md:order-2",
    ]}
  >
    <Image
      src={resolvedImage}
      alt=""
      class="aspect-[4/3] w-full object-cover opacity-80 transition duration-700 ease-out group-hover:scale-[1.03] group-hover:opacity-100"
    />
  </div>
  <div class:list={[reverse && "md:order-1"]}>
    {index && <p class="mono-label">{index}</p>}
    <h3 class="title-3 mt-3 flex items-center gap-3 text-white">
      {text}
      <GoArrowDownRight
        className="text-xl text-ieee-blue-100 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1"
        aria-hidden="true"
      />
    </h3>
    {
      isExternal && (
        <p class="copy mt-4 max-w-md">
          UC San Diego’s largest hardware-focused hackathon, hosted with HKN and
          TNT.
        </p>
      )
    }
  </div>
</a>
