---
import { GoArrowDownRight } from "react-icons/go";
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";
const { title, link, image, col } = Astro.props;
const resolvedImage = resolveImage(image);
---

<a
  href={link}
  target="_blank"
  class={`ease-in-out group relative col-span-${col} text-white`}
>
  <Image
    src={resolvedImage}
    alt="past projects image"
    class="md:h-[30vh] h-[15vh] object-cover w-full rounded-[min(1.5vw,1.35rem)] opacity-80 group-hover:opacity-40 duration-300"
  />

  <div
    class="absolute bottom-0 px-[3%] w-full bg-gradient-to-t from-black via-black to-transparent rounded-b-[min(1.5vw,1.35rem)] pb-[min(1vw,0.9rem)] pt-[5%]"
  >
    <div
      class="text-[min(1.4vw,1.26rem)] md:text-[min(1.1vw,0.99rem)] flex w-full px-[2%] justify-between items-end"
    >
      <p
        class="py-[min(0.3vw,0.27rem)] px-[min(1vw,0.9rem)] border-[min(0.1vw,0.09rem)] text-nowrap border-white rounded-full group-hover:text-ieee-yellow group-hover:border-ieee-yellow duration-300 font-light"
      >
        {title}
      </p>
      <GoArrowDownRight
        className="text-[min(3vw,2.7rem)] leading-none group-hover:text-ieee-yellow duration-300"
      />
    </div>
  </div>
</a>
