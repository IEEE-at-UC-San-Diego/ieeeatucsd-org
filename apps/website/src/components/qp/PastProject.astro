---
import { GoArrowDownRight } from "react-icons/go";
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";
const { title, link, image, span = "", delay = 0 } = Astro.props;
const resolvedImage = resolveImage(image);
---

<a
  href={link}
  target="_blank"
  class:list={[
    "group relative block row-span-1 overflow-hidden rounded-[28px] border border-ieee-blue-100/15 md:row-span-2",
    span,
  ]}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <Image
    src={resolvedImage}
    alt="past projects image"
    class="absolute inset-0 h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.04]"
  />

  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ieee-black/90 via-ieee-black/20 to-transparent"
  >
  </div>

  <div
    class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 p-3 md:p-4"
  >
    <p class="text-xs font-medium tracking-wide text-white md:text-sm">
      {title}
    </p>
    <GoArrowDownRight
      className="shrink-0 text-lg text-white/80 transition duration-300 group-hover:translate-x-1 group-hover:translate-y-1 group-hover:text-ieee-yellow md:text-xl"
    />
  </div>
</a>
