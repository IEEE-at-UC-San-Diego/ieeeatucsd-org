---
import { GoArrowDownRight } from "react-icons/go";
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";
const { title, link, image, col } = Astro.props;
const resolvedImage = resolveImage(image);
---

<a
  href={link}
  target="_blank"
  class={`ease-in-out group relative col-span-${col} text-white`}
>
  <Image
    src={resolvedImage}
    alt="past projects image"
    class="md:h-[30vh] h-[15vh] object-cover w-full rounded-[1.5cqw] opacity-80 group-hover:opacity-40 duration-300"
  />

  <div
    class="absolute bottom-0 px-[3%] w-full bg-gradient-to-t from-black via-black to-transparent rounded-b-[1.5cqw] pb-[1cqw] pt-[5%]"
  >
    <div
      class="text-[1.4cqw] md:text-[1.1cqw] flex w-full px-[2%] justify-between items-end"
    >
      <p
        class="py-[0.3cqw] px-[1cqw] border-[0.1cqw] text-nowrap border-white rounded-full group-hover:text-ieee-yellow group-hover:border-ieee-yellow duration-300 font-light"
      >
        {title}
      </p>
      <GoArrowDownRight
        className="text-[3cqw] leading-none group-hover:text-ieee-yellow duration-300"
      />
    </div>
  </div>
</a>
