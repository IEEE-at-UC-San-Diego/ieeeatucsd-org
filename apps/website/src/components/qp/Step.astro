---
const { text, number } = Astro.props;
---

<li
  class="grid grid-cols-[2.75rem_1fr] items-baseline gap-5 py-7 md:grid-cols-[5rem_1fr] md:gap-8 md:py-9"
  data-reveal
>
  <span class="font-mono-tech text-lg text-ieee-blue-100/80 md:text-xl">
    {number}
  </span>
  <p class="copy max-w-2xl text-white/80">{text}</p>
</li>
