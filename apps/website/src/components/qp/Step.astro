---
const { text, number, col, position, width } = Astro.props;
---

<div
  class={`relative col-span-${col} border-[0.1cqw] border-white/30 text-[1.5cqw] md:text-[1.2cqw] bg-gradient-to-b from-white/10 to-ieee-blue-300/10 px-[1cqw] py-[2cqw] rounded-[1cqw] `}
>
  <p
    class={`${position} text-[4cqw] opacity-10 font-bold absolute leading-tight `}
  >
    {number}
  </p>
  {text}
</div>
