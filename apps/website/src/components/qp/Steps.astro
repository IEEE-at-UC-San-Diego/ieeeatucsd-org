---
import Step from "./Step.astro";
import steps from "../../data/steps.json";
import SectionHeading from "../core/SectionHeading.astro";
---

<section class="page-section" aria-labelledby="steps-heading">
  <SectionHeading id="steps-heading" title="How it works:" />
  <ol class="mt-10 divide-y divide-white/10 border-t border-white/10">
    {steps.map((step) => <Step text={step.text} number={step.number} />)}
  </ol>
</section>
