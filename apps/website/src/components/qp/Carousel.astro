---
import SectionHeading from "../core/SectionHeading.astro";
import { Image } from "astro:assets";
import qp from "../../images/qp2.jpg";
---

<section class="page-section" aria-labelledby="closing-heading">
  <SectionHeading
    id="closing-heading"
    title="We Are Excited To See You Here!"
  />
  <p class="copy mt-6 max-w-xl">
    If you have further questions about QP, please to reach out to the QP chairs
    or Vice Chair Projects through the Board page!
  </p>
  <div class="mt-10" data-reveal>
    <Image
      src={qp}
      alt="board group photos"
      class="aspect-[2/1] w-full rounded-[28px] object-cover opacity-90"
    />
  </div>
</section>
