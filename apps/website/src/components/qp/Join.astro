---
import { Image } from "astro:assets";
import mentorship from "../../images/mentorship.webp";
import join from "../../images/join.png";
---

<div class="flex justify-center mb-[10%]">
  <div class="flex md:w-[70%] w-[80%] items-center">
    <div class="w-1/2 flex justify-center h-full relative">
      <Image src={mentorship} alt="blue background" class="mr-[20%]" />
      <Image
        src={join}
        alt="blue background"
        class="absolute rounded-full object-cover aspect-[262/433] w-[54%] md:top-[5%] top-[9%] left-0 opacity-80"
      />
    </div>
    <div
      class="w-1/2 font-light md:text-[min(1.2vw,1.08rem)] text-[min(1.6vw,1.44rem)]"
    >
      <div
        class="flex items-center md:text-[min(2.3vw,2.07rem)] text-[min(4vw,3.6rem)] mb-[5%]"
      >
        <div class="mr-[min(1vw,0.9rem)] pt-[0.5%]">
          <span class="text-ieee-yellow">●</span>
        </div>
        <p
          class="md:text-[min(2.3vw,2.07rem)] text-[min(4vw,3.6rem)] font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-ieee-yellow"
        >
          How to join
        </p>
      </div>
      <p class="my-[10%]">
        We will create a QP Application every quarter and send it out to
        prospective participants via the IEEE discord or Instagram page.
      </p>
      <!-- <p class="mb-[12%]">
        URL to Drive Folder with every school year’s QP Application forms (3 per
        school year):
      </p> -->
      <p class="mb-[12%]">Links to this quarter's application forms:</p>
      <div class="w-full flex flex-col items-center gap-4">
        <a
          href="https://forms.gle/QNxqwCkFCPPsxtAq8"
          target="_blank"
          class="py-[2%] px-[15%] md:text-[min(1.2vw,1.08rem)] text-[min(1.6vw,1.44rem)] border-[min(0.1vw,0.09rem)] border-white rounded-[min(0.5vw,0.45rem)] hover:text-ieee-yellow hover:border-ieee-yellow duration-300 font-light"
        >
          QP APPLICATION
        </a>
      </div>
    </div>
  </div>
</div>
