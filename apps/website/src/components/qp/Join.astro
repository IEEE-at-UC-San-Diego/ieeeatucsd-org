---
import { Image } from "astro:assets";
import joinPhoto from "../../images/join.png";
---

<section class="page-section">
  <div class="grid gap-8 md:grid-cols-2 md:items-center md:gap-12 lg:gap-16">
    <div
      class="relative overflow-hidden rounded-[20px] border border-ieee-blue-100/15"
      data-reveal
    >
      <Image
        src={joinPhoto}
        alt="blue background"
        class="aspect-[4/3] w-full object-cover object-top"
      />
    </div>
    <div data-reveal style="--reveal-delay: 80ms">
      <h2 class="headline text-white">How to join</h2>
      <p class="copy mt-6 max-w-xl">
        We will create a QP Application every quarter and send it out to
        prospective participants via the IEEE discord or Instagram page.
      </p>
      <p class="copy mt-5 max-w-xl">
        Links to this quarter's application forms:
      </p>
      <a
        href="https://forms.gle/QNxqwCkFCPPsxtAq8"
        target="_blank"
        class="ieee-btn ieee-btn-ghost mt-8"
      >
        QP APPLICATION
      </a>
    </div>
  </div>
</section>
