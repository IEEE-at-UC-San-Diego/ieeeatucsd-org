---
import PastProject from "./PastProject.astro";
import projects from "../../data/pastProjects.json";
import SectionHeading from "../core/SectionHeading.astro";

// Orderly bento: every tile spans a whole number of 2-row units so rows stay
// flush. Cols: 2 on mobile, 6 from md up.
const spans = [
  "col-span-2 md:col-span-4",
  "col-span-1 md:col-span-2",
  "col-span-1 md:col-span-2",
  "col-span-2 md:col-span-4",
  "col-span-1 md:col-span-3",
  "col-span-1 md:col-span-3",
  "col-span-2 md:col-span-6",
];
---

<section class="page-section" aria-labelledby="past-heading">
  <SectionHeading id="past-heading" title="Past Projects" />
  <div
    class="mt-10 grid auto-rows-[10.5rem] grid-cols-2 gap-4 md:auto-rows-[12rem] md:grid-cols-6 md:gap-5"
  >
    {
      projects.map((project, index) => (
        <PastProject
          title={project.title}
          image={project.image}
          link={project.link}
          span={spans[index % spans.length]}
          delay={Math.min(index * 60, 300)}
        />
      ))
    }
  </div>
</section>
