---
import { Image } from "astro:assets";
import eventbg from "../../images/eventbg.webp";
---

<header class="page-section pt-10 md:pt-16">
  <div class="ieee-panel overflow-hidden">
    <Image
      src={eventbg}
      alt="IEEE at UC San Diego event"
      class="w-full aspect-[2/1] object-cover"
    />
  </div>
  <h1 class="mt-8 font-display font-bold text-[clamp(2rem,5vw,3.6rem)]">
    Events
  </h1>
</header>
