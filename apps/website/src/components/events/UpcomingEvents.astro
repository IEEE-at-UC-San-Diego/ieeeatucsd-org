---
import FirestoreEventList from "./FirestoreEventList.jsx";
import SectionHeading from "../core/SectionHeading.astro";

const { events = [] } = Astro.props;
---

<section class="page-section" aria-labelledby="upcoming-heading">
  <SectionHeading id="upcoming-heading" title="Upcoming events">
    Workshops, socials, and project meetings. Subscribe on the calendar below
    for the full list.
  </SectionHeading>
  <div class="mt-8">
    <FirestoreEventList client:load events={events} />
  </div>
</section>
