---
import SuperProgram from "../../components/super/SuperProgram.astro";
import SectionHeading from "../core/SectionHeading.astro";
import programs from "../../data/programs.json";
---

<section class="page-section" aria-labelledby="programs-heading">
  <SectionHeading id="programs-heading" title="Our Programs" />
  <div class="mt-10 md:mt-14">
    {programs.map((program) => <SuperProgram {...program} />)}
  </div>
</section>
