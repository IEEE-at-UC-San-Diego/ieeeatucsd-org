---
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";
const { title, abbr, description, image, imageLeft, projects } = Astro.props;
const resolvedImage = resolveImage(image);
---

<div
  class={`flex flex-col ${imageLeft ? "md:flex-row" : "md:flex-row-reverse"} gap-8 mb-20 items-center`}
>
  <Image
    src={resolvedImage}
    alt={title}
    class="w-full md:w-1/3 aspect-video object-contain"
  />

  <div class="w-full md:w-2/3">
    <h3 class="text-3xl mb-4">
      {title}
      {abbr && <span class="text-ieee-yellow">({abbr})</span>}
    </h3>

    <p class="text-white">
      {description}
    </p>

    {
      projects && (
        <div class="mt-4">
          {projects.map((project: string) => (
            <p class="text-white">◇{project}</p>
          ))}
        </div>
      )
    }
  </div>
</div>
