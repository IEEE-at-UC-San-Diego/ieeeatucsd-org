---
import { Image } from "astro:assets";
import { resolveImage } from "../../lib/images";
const { title, abbr, description, image, projects } = Astro.props;
const resolvedImage = resolveImage(image);
---

<div
  class="grid items-start gap-8 border-t border-white/10 py-12 md:grid-cols-12 md:gap-12 md:py-16"
  data-reveal
>
  <div class="md:col-span-4">
    <div class="overflow-hidden rounded-[24px] border border-ieee-blue-100/15">
      <Image
        src={resolvedImage}
        alt={title}
        class="aspect-[4/3] w-full object-cover"
      />
    </div>
  </div>

  <div class="md:col-span-8">
    <h3 class="title-3 text-white">
      {title}
      {abbr && <span class="text-ieee-yellow">({abbr})</span>}
    </h3>

    <p class="copy mt-4 max-w-[62ch]">{description}</p>

    {
      projects && (
        <ul class="mt-7 grid gap-x-10 gap-y-3 sm:grid-cols-2">
          {projects.map((project: string) => (
            <li class="flex items-baseline gap-3 border-t border-white/10 pt-3">
              <span
                aria-hidden="true"
                class="mt-[0.62em] h-[3px] w-[3px] shrink-0 bg-ieee-blue-100/70"
              />
              <span class="copy">{project}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
