>
  <LiaDotCircle className="text-[min(2.5vw,2.25rem)] text-white" />
  <div class="flex-col">
    <h1
      class="text-[55px] md:text-[min(2.5vw,2.25rem)] font-bold text-ieee-yellow leading-none"
    >
      UCSD
    </h1>
    <h2
      class="text-[55px] md:text-[min(2.5vw,2.25rem)] font-semibold text-white leading-none"
    >
      Supercomputing
    </h2>
  </div>
</section>
