---
import { Font } from "astro:assets";

// Status Images Display Page
const statuses = [
  "submitted",
  "under_review",
  "approved",
  "in_progress",
  "paid",
  "rejected",
];

const imageWidth = 500;
const imageHeight = 150;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Reimbursement Status Images</title>
    <Font cssVariable="--font-ibm-plex-sans" />
    <Font cssVariable="--font-ibm-plex-mono" />
    <style>
      :root {
        --ink: #101828;
        --muted: #5b6b85;
        --line: #dbe3ef;
        --canvas: #f4f6fb;
        --card: #ffffff;
        --navy: #0a2463;
        --deep: #233363;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: var(--font-ibm-plex-sans);
        background: var(--canvas);
        color: var(--ink);
        margin: 0;
        padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem);
        line-height: 1.6;
      }
      .mono {
        font-family: var(--font-ibm-plex-mono);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.72rem;
        color: var(--muted);
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      header {
        border-bottom: 1px solid var(--line);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      h1 {
        margin: 0.5rem 0 0;
        font-size: clamp(1.7rem, 4vw, 2.5rem);
        letter-spacing: -0.03em;
        line-height: 1.05;
      }
      h2 {
        color: var(--ink);
        margin: 0;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
      }
      .section {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 1.5rem;
        padding: clamp(1.25rem, 3vw, 2rem);
        margin-bottom: 1.5rem;
      }
      .section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.75rem 1rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
      }
      .section-head p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
        max-width: 65ch;
      }
      .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
      }
      .status-item {
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.25rem;
        background: var(--canvas);
      }
      .status-title {
        margin: 0 0 0.75rem;
        color: var(--ink);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        text-transform: capitalize;
      }
      .status-image {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        background: var(--card);
      }
      .image-url {
        margin-top: 0.85rem;
        padding: 0.6rem 0.75rem;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        font-family: var(--font-ibm-plex-mono);
        font-size: 0.72rem;
        letter-spacing: 0.02em;
        color: var(--muted);
        word-break: break-all;
      }
      .email-demo {
        background: linear-gradient(135deg, var(--navy) 0%, var(--deep) 100%);
        color: #ffffff;
        padding: clamp(1.5rem, 3vw, 2rem);
        border-radius: 1rem;
      }
      .email-demo h3 {
        margin: 0 0 1rem;
        color: #ffffff;
        font-size: 1.1rem;
      }
      .email-demo p {
        margin: 0 0 1.25rem;
        color: rgba(255, 255, 255, 0.78);
      }
      .email-demo p:last-child {
        margin: 1.25rem 0 0;
        font-size: 0.85rem;
      }
      .email-demo img {
        width: 100%;
        max-width: 500px;
        height: auto;
        border-radius: 0.6rem;
        display: block;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <p class="mono">IEEE at UC San Diego · Reimbursement</p>
        <h1>Reimbursement Status Progress Images</h1>
      </header>

      <section class="section">
        <div class="section-head">
          <h2>PNG Status Progress Images</h2>
          <p>
            High-quality PNG images generated from SVG using Puppeteer with
            transparent backgrounds:
          </p>
        </div>

        <div class="status-grid">
          {
            statuses.map((status) => (
              <div class="status-item">
                <h3 class="status-title">{status.replace("_", " ")}</h3>
                <img
                  src={`/api/generate-status-image?status=${status}&width=${imageWidth}&height=${imageHeight}`}
                  alt={`Status progress for ${status}`}
                  class="status-image"
                  loading="lazy"
                />
                <div class="image-url">
                  PNG API: /api/generate-status-image?status={status}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Email Integration Demo</h2>
          <p>
            Here's how the PNG images look when embedded in an email-like
            environment:
          </p>
        </div>

        <div class="email-demo">
          <h3>IEEE UCSD Reimbursement Update</h3>
          <p>Your reimbursement request has been updated:</p>

          <img
            src={`/api/generate-status-image?status=approved&width=500&height=150`}
            alt="Status progress embedded in email"
            loading="lazy"
          />

          <p>
            PNG images with transparent backgrounds work perfectly in all email
            clients
          </p>
        </div>
      </section>
    </div>
  </body>
</html>
