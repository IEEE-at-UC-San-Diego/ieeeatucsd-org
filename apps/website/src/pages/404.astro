---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found - IEEE at UC San Diego">
  <section class="page-section flex min-h-[70vh] flex-col justify-center">
    <div class="bp-grid">
      <h1 class="display" data-reveal style="--reveal-delay: 60ms">404</h1>
      <p class="lead mt-6 max-w-xl" data-reveal style="--reveal-delay: 120ms">
        That page is not on this site. Head home or join us in Project Space.
      </p>
      <div
        class="mt-8 flex flex-wrap gap-3"
        data-reveal
        style="--reveal-delay: 180ms"
      >
        <a class="ieee-btn ieee-btn-primary" href="/">Back home</a>
        <a class="ieee-btn ieee-btn-ghost" href="/join#project-space">
          Project Space
        </a>
      </div>
    </div>
  </section>
</Layout>
