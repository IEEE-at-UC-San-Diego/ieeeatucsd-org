---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found - IEEE at UC San Diego">
  <section class="page-section min-h-[70vh] flex flex-col justify-center">
    <p class="eyebrow text-ieee-yellow text-xs md:text-sm mb-4">Error</p>
    <h1 class="font-display font-bold text-[clamp(3rem,10vw,7rem)]">404</h1>
    <p class="mt-4 text-lead text-white/75 max-w-xl">
      That page is not on this site. Head home or join us in Project Space.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="ieee-btn ieee-btn-primary" href="/">Back home</a>
      <a class="ieee-btn ieee-btn-ghost" href="/join#project-space">
        Project Space
      </a>
    </div>
  </section>
</Layout>
