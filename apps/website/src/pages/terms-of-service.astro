---
import Layout from "../layouts/Layout.astro";
import Title from "../components/core/Title.astro";
import { LEGAL_VERSIONS, formatEffectiveDate } from "../config/legalVersions";

const pageData = {
  title: "Terms of Service",
  description:
    "Terms and conditions for using IEEE UC San Diego Student Branch's services and platform.",
};

const lastUpdated = formatEffectiveDate(LEGAL_VERSIONS.TOS_EFFECTIVE_DATE);

const toc = [
  {
    href: "#acceptance",
    short: "1. Acceptance",
    long: "1. Acceptance of Terms",
  },
  {
    href: "#user-accounts",
    short: "2. User Accounts",
    long: "2. User Accounts",
  },
  {
    href: "#permitted-use",
    short: "3. Permitted Use",
    long: "3. Permitted Use",
  },
  {
    href: "#prohibited-conduct",
    short: "4. Prohibited Conduct",
    long: "4. Prohibited Conduct",
  },
  {
    href: "#intellectual-property",
    short: "5. Intellectual Property",
    long: "5. Intellectual Property",
  },
  { href: "#user-content", short: "6. User Content", long: "6. User Content" },
  { href: "#disclaimers", short: "7. Disclaimers", long: "7. Disclaimers" },
  {
    href: "#limitation-liability",
    short: "8. Limitation of Liability",
    long: "8. Limitation of Liability",
  },
  {
    href: "#changes-terms",
    short: "9. Changes to Terms",
    long: "9. Changes to Terms",
  },
  {
    href: "#contact-tos",
    short: "10. Contact",
    long: "10. Contact Information",
  },
];
---

<Layout title={pageData.title} description={pageData.description}>
  <div class="legal-doc">
    <Title title="Terms of Service" />

    <div class="legal-layout">
      <!-- Table of Contents -->
      <nav class="legal-toc" aria-label="Table of contents">
        <details class="legal-toc-mobile" open>
          <summary class="mono-label legal-toc-summary"
            >Table of Contents</summary
          >
          <ul class="legal-toc-list">
            {
              toc.map((item) => (
                <li>
                  <a href={item.href} class="legal-toc-link">
                    {item.long}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="legal-toc-inner">
          <p class="mono-label legal-toc-title">On this page</p>
          <ul class="legal-toc-list">
            {
              toc.map((item) => (
                <li>
                  <a href={item.href} class="legal-toc-link">
                    {item.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <!-- Document -->
      <article class="legal-body">
        <header class="legal-meta">
          <p class="legal-updated">Last updated: {lastUpdated}</p>
          <p class="legal-intro">
            Welcome to IEEE UC San Diego Student Branch. By accessing or using
            our services, you agree to be bound by these Terms of Service.
            Please read them carefully before using our platform.
          </p>
        </header>

        <!-- 1. Acceptance of Terms -->
        <section class="legal-section" id="acceptance">
          <h2>1. Acceptance of Terms</h2>
          <p class="legal-sub">Your agreement to these terms</p>
          <p>
            By accessing or using the IEEE UC San Diego Student Branch website,
            dashboard, and related services (collectively, the "Services"), you
            agree to be bound by these Terms of Service ("Terms"). If you do not
            agree to these Terms, please do not use our Services.
          </p>
          <p>
            These Terms constitute a legally binding agreement between you and
            IEEE UC San Diego Student Branch ("IEEE UCSD"), a registered student
            organization at the University of California, San Diego and an
            official IEEE Student Branch.
          </p>
          <aside class="legal-note">
            <p>
              <strong>Important:</strong> You must be at least 18 years old or have
              parental/guardian consent to use our Services. By using our Services,
              you represent that you meet this requirement.
            </p>
          </aside>
        </section>

        <!-- 2. User Accounts -->
        <section class="legal-section" id="user-accounts">
          <h2>2. User Accounts</h2>
          <p class="legal-sub">Account registration and security</p>
          <p>
            To access certain features of our Services, you may need to create
            an account. When creating an account, you agree to:
          </p>
          <ul class="legal-list">
            <li>
              Provide accurate, current, and complete information during
              registration
            </li>
            <li>Maintain and update your information to keep it accurate</li>
            <li>
              Maintain the security of your account credentials and not share
              them with others
            </li>
            <li>
              Notify us immediately of any unauthorized access to your account
            </li>
            <li>
              Accept responsibility for all activities that occur under your
              account
            </li>
          </ul>
          <p>
            We reserve the right to suspend or terminate accounts that violate
            these Terms or for any other reason at our discretion.
          </p>
        </section>

        <!-- 3. Permitted Use -->
        <section class="legal-section" id="permitted-use">
          <h2>3. Permitted Use</h2>
          <p class="legal-sub">How you may use our Services</p>
          <p>You may use our Services for the following purposes:</p>
          <ul class="legal-rows">
            <li>
              <strong>Event Participation:</strong> Registering for, checking into,
              and participating in IEEE UC San Diego Student Branch events
            </li>
            <li>
              <strong>Financial Services:</strong> Submitting reimbursement requests
              and managing fund deposits
            </li>
            <li>
              <strong>Member Features:</strong> Accessing your profile, viewing leaderboards,
              and connecting with the community
            </li>
            <li>
              <strong>Career Development:</strong> Uploading resumes and connecting
              with sponsors (with your consent)
            </li>
          </ul>
        </section>

        <!-- 4. Prohibited Conduct -->
        <section class="legal-section" id="prohibited-conduct">
          <h2>4. Prohibited Conduct</h2>
          <p class="legal-sub">Actions that are not allowed</p>
          <p>When using our Services, you agree NOT to:</p>
          <ul class="legal-list legal-list-no">
            <li>
              Violate any applicable laws, regulations, or university policies
            </li>
            <li>
              Impersonate any person or entity or misrepresent your affiliation
            </li>
            <li>
              Submit false or fraudulent information, including fake receipts or
              event check-ins
            </li>
            <li>
              Attempt to gain unauthorized access to other users' accounts or
              our systems
            </li>
            <li>
              Interfere with or disrupt the Services or servers/networks
              connected to them
            </li>
            <li>Upload viruses, malware, or other malicious code</li>
            <li>Harass, abuse, or harm other users or organization members</li>
            <li>
              Use the Services for any commercial purpose without our written
              consent
            </li>
          </ul>
        </section>

        <!-- 5. Intellectual Property -->
        <section class="legal-section" id="intellectual-property">
          <h2>5. Intellectual Property</h2>
          <p class="legal-sub">Ownership and rights</p>
          <p>
            The IEEE UC San Diego Student Branch name, logo, and all content and
            materials available through our Services, including text, graphics,
            website name, code, images, and logos, are the property of IEEE UC
            San Diego Student Branch or its licensors and are protected by
            applicable intellectual property laws.
          </p>
          <p>
            The IEEE name and logo are trademarks of the Institute of Electrical
            and Electronics Engineers, Inc. and are used with permission under
            license from IEEE.
          </p>
          <p>
            UC San Diego logos and trademarks are used with permission from the
            University of California, San Diego.
          </p>
          <p>
            Other company logos displayed on our platform are used solely to
            represent partnerships and sponsorships with those organizations.
          </p>
          <aside class="legal-note">
            <p>
              You are granted a limited, non-exclusive, non-transferable license
              to access and use our Services for personal, non-commercial
              purposes in accordance with these Terms.
            </p>
          </aside>
        </section>

        <!-- 6. User Content -->
        <section class="legal-section" id="user-content">
          <h2>6. User Content</h2>
          <p class="legal-sub">Content you submit to our Services</p>
          <p>
            You may submit content to our Services, including profile
            information, resumes, receipts, and other materials ("User
            Content"). By submitting User Content, you:
          </p>
          <ul class="legal-list">
            <li>Retain ownership of your User Content</li>
            <li>
              Grant IEEE UC San Diego Student Branch a license to use, store,
              and process your content as necessary to provide the Services
            </li>
            <li>
              Represent that you have the right to submit the content and that
              it does not violate any third-party rights
            </li>
          </ul>
          <aside class="legal-note legal-note-warn">
            <p class="legal-note-title">Resume Sharing Consent</p>
            <p>
              By uploading your resume to our platform, you grant IEEE UC San
              Diego Student Branch permission to share your resume with our
              sponsors and partner organizations for recruiting and networking
              purposes. Your resume may be shared at career fairs, networking
              events, and through sponsor portals. If you do not wish to have
              your resume shared, please do not upload it to our platform.
            </p>
          </aside>
        </section>

        <!-- 7. Disclaimers -->
        <section class="legal-section" id="disclaimers">
          <h2>7. Disclaimers</h2>
          <p class="legal-sub">Limitations on our guarantees</p>
          <aside class="legal-note">
            <p class="legal-note-title">As-Is Basis</p>
            <p>
              THE SERVICES ARE PROVIDED "AS IS" AND "AS AVAILABLE" WITHOUT
              WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING BUT
              NOT LIMITED TO IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR
              A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
            </p>
          </aside>
          <p>
            IEEE UC San Diego Student Branch is a student organization run by
            volunteers. We do not guarantee that the Services will be
            uninterrupted, secure, or error-free.
          </p>
        </section>

        <!-- Data Retention -->
        <section class="legal-section" id="data-retention">
          <h2>Data Retention</h2>
          <p class="legal-sub">How long we keep your data</p>
          <p>
            IEEE UC San Diego Student Branch retains user data indefinitely to
            maintain historical records for our organization, including event
            attendance history, membership records, and participation tracking.
          </p>
          <p>Data may be affected in the following circumstances:</p>
          <ul class="legal-list">
            <li>System resets or migrations that require data restructuring</li>
            <li>
              Technical issues or circumstances that may result in data loss
            </li>
            <li>
              User requests for data deletion (subject to our operational
              requirements)
            </li>
          </ul>
          <aside class="legal-note">
            <p>
              While we make reasonable efforts to maintain data integrity, we
              cannot guarantee the permanent preservation of all data and are
              not liable for any data loss that may occur.
            </p>
          </aside>
        </section>

        <!-- 8. Limitation of Liability -->
        <section class="legal-section" id="limitation-liability">
          <h2>8. Limitation of Liability</h2>
          <p class="legal-sub">Limits on our liability</p>
          <p>
            TO THE MAXIMUM EXTENT PERMITTED BY LAW, IEEE UC SAN DIEGO STUDENT
            BRANCH, ITS OFFICERS, MEMBERS, AND AFFILIATES SHALL NOT BE LIABLE
            FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE
            DAMAGES, INCLUDING LOSS OF DATA, PROFITS, OR GOODWILL, ARISING FROM
            YOUR USE OF THE SERVICES.
          </p>
          <p>
            Our total liability for any claims arising from or related to these
            Terms or the Services shall not exceed the amount you have paid to
            IEEE UC San Diego Student Branch, if any, in the twelve months
            preceding the claim.
          </p>
        </section>

        <!-- 9. Changes to Terms -->
        <section class="legal-section" id="changes-terms">
          <h2>9. Changes to Terms</h2>
          <p class="legal-sub">How we update these terms</p>
          <p>
            We may update these Terms from time to time. When we make changes,
            we will:
          </p>
          <ul class="legal-list">
            <li>Update the "Last updated" date at the top of this page</li>
            <li>
              Notify you of significant changes through the dashboard or email
            </li>
            <li>
              Require you to accept the updated terms before continuing to use
              the Services
            </li>
          </ul>
          <p>
            Your continued use of the Services after changes are posted
            constitutes your acceptance of the updated Terms.
          </p>
        </section>

        <!-- 10. Contact Information -->
        <section class="legal-section" id="contact-tos">
          <h2>10. Contact Information</h2>
          <p class="legal-sub">How to reach us</p>
          <p>
            If you have any questions about these Terms of Service, please
            contact us:
          </p>
          <ul class="legal-rows">
            <li>
              <strong>Email</strong>
              <a href="mailto:ieee@ucsd.edu">ieee@ucsd.edu</a>
            </li>
            <li>
              <strong>Website</strong>
              <a href="https://ieeeatucsd.org">ieeeatucsd.org</a>
            </li>
            <li>
              <strong>Address</strong>
              IEEE UC San Diego Student Branch<br />
              University of California, San Diego<br />
              9500 Gilman Drive<br />
              La Jolla, CA 92093
            </li>
          </ul>
        </section>

        <!-- Related Links -->
        <section class="legal-related">
          <h2>Related Documents</h2>
          <p>
            <a href="/privacy-policy">Privacy Policy</a>
          </p>
        </section>
      </article>
    </div>
  </div>
</Layout>

<style>
  /* ---------- Layout ---------- */
  .legal-doc :global(.legal-layout) {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  @media (min-width: 1024px) {
    .legal-doc :global(.legal-layout) {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 4.5rem;
    }
  }

  .legal-doc :global(.legal-body) {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---------- Table of contents ---------- */
  .legal-doc :global(.legal-toc-inner) {
    display: none;
  }

  @media (min-width: 1024px) {
    .legal-doc :global(.legal-toc-inner) {
      display: block;
      position: sticky;
      top: 6.5rem;
    }

    .legal-doc :global(.legal-toc-mobile) {
      display: none;
    }
  }

  .legal-doc :global(.legal-toc-summary) {
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .legal-doc :global(.legal-toc-title) {
    margin-bottom: 1.25rem;
  }

  .legal-doc :global(.legal-toc-list) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .legal-doc :global(.legal-toc-link) {
    display: block;
    padding: 0.35rem 0 0.35rem 0.85rem;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition:
      color var(--duration-ui) ease,
      border-color var(--duration-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .legal-doc :global(.legal-toc-link:hover) {
      color: #fff;
      border-left-color: rgba(243, 193, 53, 0.6);
    }
  }

  /* ---------- Header meta ---------- */
  .legal-doc :global(.legal-meta) {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(136, 191, 236, 0.14);
  }

  .legal-doc :global(.legal-updated) {
    font-family: var(--font-ibm-plex-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .legal-doc :global(.legal-meta .legal-intro) {
    margin-top: 1.25rem;
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---------- Sections ---------- */
  .legal-doc :global(.legal-section) {
    scroll-margin-top: 7rem;
  }

  .legal-doc :global(.legal-section + .legal-section) {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(136, 191, 236, 0.14);
  }

  .legal-doc :global(.legal-section > h2) {
    font-size: clamp(1.35rem, 2.1vw, 1.7rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    scroll-margin-top: 7rem;
  }

  .legal-doc :global(.legal-section > .legal-sub) {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.45);
  }

  .legal-doc :global(.legal-section h3) {
    margin-top: 2.5rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #fff;
  }

  /* ---------- Body rhythm ---------- */
  .legal-doc :global(.legal-body p + p),
  .legal-doc :global(.legal-body p + ul),
  .legal-doc :global(.legal-body ul + p) {
    margin-top: 1.15rem;
  }

  .legal-doc :global(.legal-body strong) {
    color: #fff;
    font-weight: 600;
  }

  .legal-doc :global(.legal-body a) {
    text-underline-offset: 0.22em;
  }

  /* ---------- Lists ---------- */
  .legal-doc :global(.legal-list) {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .legal-doc :global(.legal-list > li) {
    position: relative;
    padding-left: 1.35rem;
  }

  .legal-doc :global(.legal-list > li + li) {
    margin-top: 0.65rem;
  }

  .legal-doc :global(.legal-list > li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 1px;
    background: #f3c135;
  }

  .legal-doc :global(.legal-list-no > li::before) {
    content: "✕";
    top: -0.05em;
    width: auto;
    height: auto;
    background: none;
    font-size: 0.8rem;
    line-height: 1.7;
    color: rgba(248, 113, 113, 0.85);
  }

  /* ---------- Rows ---------- */
  .legal-doc :global(.legal-rows) {
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .legal-doc :global(.legal-rows > li) {
    padding: 1.15rem 0;
    border-top: 1px solid rgba(136, 191, 236, 0.12);
  }

  .legal-doc :global(.legal-rows > li:last-child) {
    border-bottom: 1px solid rgba(136, 191, 236, 0.12);
  }

  .legal-doc :global(.legal-rows > li > strong) {
    display: block;
    margin-bottom: 0.3rem;
  }

  /* ---------- Notes ---------- */
  .legal-doc :global(.legal-note) {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(136, 191, 236, 0.16);
    border-radius: 1rem;
    background: rgba(136, 191, 236, 0.05);
  }

  .legal-doc :global(.legal-note p) {
    margin: 0;
  }

  .legal-doc :global(.legal-note .legal-note-title) {
    margin-bottom: 0.5rem;
    font-family: var(--font-ibm-plex-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .legal-doc :global(.legal-note-warn) {
    border-color: rgba(243, 193, 53, 0.3);
    background: rgba(243, 193, 53, 0.06);
  }

  /* ---------- Related ---------- */
  .legal-doc :global(.legal-related) {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(136, 191, 236, 0.14);
  }

  .legal-doc :global(.legal-related h2) {
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
  }

  .legal-doc :global(.legal-related p) {
    margin-top: 1rem;
  }
</style>
