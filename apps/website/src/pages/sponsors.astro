---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Title from "@/components/core/Title.astro";
import { LiaDotCircle } from "react-icons/lia";
import sponsors from "../data/sponsors.json";
import { resolveImage } from "../lib/images";
---

<Layout>
  <Title title="Sponsorship" />
  <div class="w-full flex justify-center text-[min(1.2vw,1.08rem)]">
    <p
      class="w-[70%] my-[min(4vw,3.6rem)] text-white/90 border-l-[min(0.5vw,0.45rem)] pl-[min(1vw,0.9rem)] border-ieee-yellow"
    >
      Sponsors have played a vital role in the growth and success of IEEE at UC
      San Diego.<br /><br /> Through their generous support, our organization has
      been able to expand its projects, host impactful workshops, and empower students
      to turn their ideas into real engineering achievements. Thanks to our sponsors,
      teams like TritonBot have continuously represented UCSD on the international
      stage at the RoboCup competition, showcasing years of innovation and dedication
      made possible by sustained collaboration and resources. <br /><br />We
      sincerely thank our current sponsors for their continued belief in our
      mission and warmly welcome new sponsors to join us in shaping the future
      of student innovation. To get involved, please email us or fill out the
      contact form below — we look forward to partnering with you in growing the
      next generation of engineers.
    </p>
  </div>

  <div class="flex flex-col items-center text-white my-[min(5vw,4.5rem)]">
    <div
      class="flex items-center text-[min(4.5vw,4.05rem)] md:text-[min(2.5vw,2.25rem)] mb-[3%]"
    >
      <LiaDotCircle className="mr-[min(1vw,0.9rem)] pt-[0.5%]" />
      <p
        class="text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-ieee-black"
      >
        Interested in sponsoring us?
      </p>
    </div>

    <a
      href="mailto:ieee@ucsd.edu"
      class="ieee-btn ieee-btn-ghost md:text-[min(1.2vw,1.08rem)] text-[min(2vw,1.8rem)]"
    >
      Please email ieee@ucsd.edu
    </a>

    <div
      class="flex items-center text-[min(4.5vw,4.05rem)] md:text-[min(2.5vw,2.25rem)] mt-[min(10vw,9rem)]"
    >
      <LiaDotCircle className="mr-[min(1vw,0.9rem)] pt-[0.5%]" />
      <p
        class="text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-ieee-black"
      >
        Our Sponsors
      </p>
    </div>

    <div class="grid grid-cols-3 mb-[min(10vw,9rem)]">
      {
        sponsors.map((sponsor) => (
          <div class="flex items-center justify-center p-[min(1vw,0.9rem)] aspect-video w-[min(20vw,18rem)]">
            <Image
              src={resolveImage(sponsor)}
              alt={sponsor}
              class="object-contain"
            />
          </div>
        ))
      }
    </div>

    <div class="flex">
      <div class="w-2/5 flex flex-col items-end mr-[5%]">
        <div
          class="flex items-center text-[min(4.7vw,4.23rem)] md:text-[min(2.5vw,2.25rem)] mb-[15%]"
        >
          <LiaDotCircle className="mr-[min(1vw,0.9rem)] pt-[0.5%]" />
          <p
            class="text-transparent bg-clip-text bg-gradient-to-b from-white via-white to-ieee-black"
          >
            Become a Sponsor
          </p>
        </div>
        <p class="text-end w-[75%] text-[min(1.3vw,1.17rem)]">
          To get involved, please email us <br /> or fill out the contact form to
          the right — we look forward to partnering with you in growing the next generation
          of engineers.
        </p>
      </div>

      <form
        method="POST"
        action="/api/email/send-sponsor-confirmation"
        class="border-white rounded-[min(3vw,2.7rem)] border w-[45%] h-[min(33vw,29.7rem)] py-[3%] px-[5%] bg-white/5 font-extralight text-[min(1.1vw,0.99rem)]"
      >
        <p>Email</p>
        <input
          type="email"
          name="email"
          placeholder="ieee@ucsd.edu"
          required
          class="mb-[min(1vw,0.9rem)] w-full bg-transparent border-b-[min(0.1vw,0.09rem)] border-white/80"
        />

        <p>Phone</p>
        <input
          type="text"
          name="phone"
          placeholder="123-456-7890"
          class="mb-[min(1vw,0.9rem)] w-full bg-transparent border-b-[min(0.1vw,0.09rem)] border-white/80"
        />

        <p>Message</p>
        <textarea
          name="message"
          class="w-full bg-transparent border-[min(0.1vw,0.09rem)] mb-[min(1vw,0.9rem)] border-white h-[50%] mt-[min(0.5vw,0.45rem)]"
          required></textarea>

        <div class="flex justify-end">
          <button type="submit" class="ieee-btn ieee-btn-ghost">
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>
