---
import Layout from "../../layouts/Layout.astro";
import Questions from "../../components/core/Questions.astro";
import roboFaq from "../../data/roboFaq.json";
import About from "../../components/core/About.astro";
import RoboTitle from "../../components/robocub/RoboTitle.astro";
import robocupImage from "../../images/robocup.webp";
import Subteams from "../../components/robocub/Subteams.astro";
import Timeline from "../../components/qp/Timeline.astro";
import Competition from "../../components/signal/Competition.astro";
import roboTimeline from "../../data/roboTimeline.json";
import roboLinks from "../../data/roboLinks.json";
import Sponsors from "../../components/robocub/Sponsors.astro";

const seoProps = {
  title: "TritonBots FC - RoboCup Small-Size League - IEEE at UC San Diego",
  description:
    "Join TritonBots FC, UCSD's RoboCup Small-Size League team. Develop fully autonomous soccer-playing robots with custom hardware and software. Compete internationally in RoboCup.",
  keywords: [
    "RoboCup",
    "TritonBots",
    "autonomous robots",
    "robot soccer",
    "small-size league",
    "robotics competition",
    "UCSD robotics",
    "computer vision",
    "autonomous systems",
  ],
  image: "/robocup.webp",
};
---

<Layout {...seoProps}>
  <RoboTitle />
  <About
    title="What is RoboCup?"
    text="TritonBots FC is UCSD’s RoboCup Small-Size League Team. Students develop fully autonomous soccer playing robots to compete in the annual RoboCup International Competition. All hardware is custom built and software programmed from the ground up. Position, velocity, and field data is received in real time through computer vision."
  />
  <div class="w-full flex justify-center">
    <div class="w-3/5 flex justify-between mb-[15%]">
      {
        roboLinks.map((roboLink) => (
          <a
            href={roboLink.link}
            target="_blank"
            rel="noreferrer"
            class="ieee-btn ieee-btn-ghost w-[30%] text-center text-sm md:text-base"
          >
            {roboLink.text}
          </a>
        ))
      }
    </div>
  </div>
  <Competition
    picture={robocupImage}
    name="Preparing for RoboCup 2026"
    description="Our team submitted this year’s qualification video to compete in the RoboCup 2026 International Competition held in Incheon, Korea."
    link="https://drive.google.com/file/d/1dX9MjNjK_A-GmBK_ELF-zYO38qwvRm0L/view?usp=drive_link"
    linktext="Qualification Video"
  />
  <Subteams />
  <Timeline timeline={roboTimeline} />
  <Questions faq={roboFaq} />
  <Sponsors />
</Layout>
