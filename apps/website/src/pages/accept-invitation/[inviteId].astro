---
const { inviteId } = Astro.params;

if (!inviteId) {
  return Astro.redirect("/");
}

const dashboardBaseUrl = (
  import.meta.env.PUBLIC_DASHBOARD_URL || "https://dashboard.ieeeatucsd.org"
)
  .trim()
  .replace(/\/$/, "");

return Astro.redirect(`${dashboardBaseUrl}/accept-invitation/${inviteId}`, 302);
---
