---
import Layout from "../layouts/Layout.astro";
import Title from "../components/core/Title.astro";
import QP from "../components/projects/QP.astro";
import AP from "../components/projects/AP.astro";

const seoProps = {
  title: "Projects - IEEE at UC San Diego",
  description:
    "Explore IEEE UCSD's technical projects including Quarterly Projects, RoboCup SSL robotics, Signal Processing, and Supercomputing. Gain hands-on experience in cutting-edge technology.",
  keywords: [
    "IEEE UCSD projects",
    "quarterly projects",
    "RoboCup",
    "robotics",
    "signal processing",
    "supercomputing",
    "student projects",
    "engineering projects UCSD",
  ],
  image: "/project.webp",
};
---

<Layout {...seoProps}>
  <Title title="Projects" />
  <QP />
  <AP />
</Layout>
