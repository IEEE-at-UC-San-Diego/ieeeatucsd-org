---
import Layout from "../layouts/Layout.astro";
import Social from "../components/core/Social.astro";
import JoinHero from "../components/join/JoinHero.astro";
import ProjectSpace from "../components/join/ProjectSpace.astro";
import Resources from "../components/join/Resources.astro";
import Questions from "../components/core/Questions.astro";
import Involvements from "../components/join/Involvements.astro";
import faq from "../data/faq.json";

const seoProps = {
  title: "Join IEEE at UC San Diego - Get Involved Today",
  description:
    "Become a member of IEEE at UC San Diego! Visit Project Space in EBU1-4710, join Discord, and access workshops, projects, and resources. No experience required — all majors welcome.",
  keywords: [
    "join IEEE UCSD",
    "IEEE membership",
    "UCSD student organization",
    "engineering club",
    "get involved UCSD",
    "student membership",
    "IEEE benefits",
    "IEEE Project Space",
  ],
  image: "/logos/blue_logo_only.png",
};
---

<Layout {...seoProps}>
  <JoinHero />
  <ProjectSpace />
  <Involvements />
  <Resources />
  <Questions faq={faq} />
  <Social />
</Layout>
