---
import Layout from "../layouts/Layout.astro";
import Title from "../components/core/Title.astro";
import { LEGAL_VERSIONS, formatEffectiveDate } from "../config/legalVersions";

const pageData = {
  title: "Privacy Policy",
  description:
    "Learn how IEEE UC San Diego Student Branch collects, uses, and protects your personal information.",
};

const lastUpdated = formatEffectiveDate(
  LEGAL_VERSIONS.PRIVACY_POLICY_EFFECTIVE_DATE,
);

const toc = [
  {
    href: "#information-collect",
    short: "1. Information We Collect",
    long: "1. Information We Collect",
  },
  {
    href: "#how-we-use",
    short: "2. How We Use It",
    long: "2. How We Use Your Information",
  },
  {
    href: "#information-sharing",
    short: "3. Information Sharing",
    long: "3. Information Sharing and Disclosure",
  },
  {
    href: "#data-storage",
    short: "4. Storage & Security",
    long: "4. Data Storage and Security",
  },
  {
    href: "#data-retention",
    short: "5. Data Retention",
    long: "5. Data Retention",
  },
  {
    href: "#your-rights",
    short: "6. Your Rights",
    long: "6. Your Rights and Choices",
  },
  {
    href: "#cookies-tracking",
    short: "7. Cookies",
    long: "7. Cookies and Tracking",
  },
  {
    href: "#international-transfers",
    short: "8. International Transfers",
    long: "8. International Data Transfers",
  },
  {
    href: "#policy-changes",
    short: "9. Changes",
    long: "9. Changes to This Policy",
  },
  {
    href: "#contact-info",
    short: "10. Contact",
    long: "10. Contact Information",
  },
];
---

<Layout title={pageData.title} description={pageData.description}>
  <div class="legal-doc">
    <Title title="Privacy Policy" />

    <div class="legal-layout">
      <!-- Table of Contents -->
      <nav class="legal-toc" aria-label="Table of contents">
        <details class="legal-toc-mobile" open>
          <summary class="mono-label legal-toc-summary"
            >Table of Contents</summary
          >
          <ul class="legal-toc-list">
            {
              toc.map((item) => (
                <li>
                  <a href={item.href} class="legal-toc-link">
                    {item.long}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>

        <div class="legal-toc-inner">
          <p class="mono-label legal-toc-title">On this page</p>
          <ul class="legal-toc-list">
            {
              toc.map((item) => (
                <li>
                  <a href={item.href} class="legal-toc-link">
                    {item.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <!-- Document -->
      <article class="legal-body">
        <header class="legal-meta">
          <p class="legal-updated">Last updated: {lastUpdated}</p>
          <p class="legal-intro">
            At IEEE at UCSD, we are committed to protecting your privacy and
            ensuring the security of your personal information. This privacy
            policy explains how we collect, use, and safeguard your data.
          </p>
        </header>

        <!-- 1. Information We Collect -->
        <section class="legal-section" id="information-collect">
          <h2>1. Information We Collect</h2>
          <p class="legal-sub">What data we gather and why</p>

          <h3>Personal Information</h3>
          <ul class="legal-list">
            <li>
              Name, email address, and profile picture (from Google OAuth or
              email signup)
            </li>
            <li>
              Academic information (major, graduation year, student PID, IEEE
              member ID)
            </li>
            <li>
              Contact preferences, display settings, and accessibility
              preferences
            </li>
            <li>Payment information (Zelle details for reimbursements only)</li>
            <li>
              IEEE email address and credentials (when you request an
              @ieeeucsd.org account)
            </li>
          </ul>

          <h3>Activity Data</h3>
          <ul class="legal-list">
            <li>
              Event attendance records, check-in codes, food preferences, and
              participation points
            </li>
            <li>
              Account creation date, last login time, and authentication method
              used
            </li>
            <li>
              Reimbursement requests, receipts, and financial transaction
              records
            </li>
            <li>
              Resume files (optional, stored only if you choose to upload for
              sponsor sharing)
            </li>
            <li>Event files and attachments uploaded by officers</li>
          </ul>

          <h3>Technical Information</h3>
          <ul class="legal-list">
            <li>IP addresses (for security and session management)</li>
            <li>Browser type, version, and device information</li>
            <li>Authentication method (Logto social login or email)</li>
            <li>
              Session cookies for authentication and preference storage (no
              analytics tracking)
            </li>
          </ul>
        </section>

        <!-- 2. How We Use Your Information -->
        <section class="legal-section" id="how-we-use">
          <h2>2. How We Use Your Information</h2>
          <p class="legal-sub">The purposes for data processing</p>
          <p>We use the information we collect for the following purposes:</p>
          <ul class="legal-rows">
            <li>
              <strong>Membership Management:</strong> Process memberships, track participation,
              manage user roles and permissions, and provide organizational services
            </li>
            <li>
              <strong>Event Management:</strong> Register attendees, track check-ins,
              manage food preferences, award participation points, and sync with calendar
            </li>
            <li>
              <strong>Financial Operations:</strong> Process reimbursement requests,
              parse receipts using AI, maintain financial records, and manage fund
              deposits
            </li>
            <li>
              <strong>Career Services:</strong> Share resumes with sponsors (only
              with your explicit consent) and provide networking opportunities
            </li>
            <li>
              <strong>Communication:</strong> Send organizational updates, event notifications,
              reimbursement status updates, and manage IEEE email services
            </li>
            <li>
              <strong>Security:</strong> Prevent unauthorized access, detect fraud,
              maintain system integrity, and protect member data
            </li>
            <li>
              <strong>Legal Compliance:</strong> Meet organizational requirements,
              comply with university policies, and fulfill regulatory obligations
            </li>
          </ul>
        </section>

        <!-- 3. Information Sharing and Disclosure -->
        <section class="legal-section" id="information-sharing">
          <h2>3. Information Sharing and Disclosure</h2>
          <p class="legal-sub">Who has access to your data</p>

          <h3>Within Our Organization</h3>
          <ul class="legal-list">
            <li>
              <strong>Officers:</strong> Executive and General Officers may access
              member data for organizational management, event coordination, and reimbursement
              processing
            </li>
            <li>
              <strong>Sponsors:</strong> Silver tier and above sponsors may access
              resume database (only with your explicit consent)
            </li>
            <li>
              <strong>Webmaster:</strong> Receives notifications about IEEE email
              account creation and system administration
            </li>
          </ul>

          <h3>Third-Party Service Providers</h3>
          <div class="legal-providers">
            <div class="legal-provider">
              <strong class="legal-provider-name">Convex (Self-Hosted)</strong>
              <p>
                <strong>Purpose:</strong> Primary database and file storage for the
                member dashboard<br />
                <strong>Data Shared:</strong> User profiles, event data, reimbursements,
                resumes, and uploaded files<br />
                <strong>Location:</strong> United States (self-hosted deployment)<br
                />
                <strong>Services Used:</strong> Convex database and file storage
              </p>
            </div>

            <div class="legal-provider">
              <strong class="legal-provider-name">Logto</strong>
              <p>
                <strong>Purpose:</strong> Authentication and identity management for
                the member dashboard<br />
                <strong>Data Shared:</strong> Name, email, profile picture, and authentication
                session data<br />
                <strong>Privacy Policy:</strong>
                <a
                  href="https://logto.io/privacy"
                  target="_blank"
                  rel="noopener noreferrer">logto.io/privacy</a
                >
              </p>
            </div>

            <div class="legal-provider">
              <strong class="legal-provider-name">Resend</strong>
              <p>
                <strong>Purpose:</strong> Transactional email delivery service<br
                />
                <strong>Data Shared:</strong> Recipient email addresses, names, and
                email content (invitations, notifications, reimbursement updates,
                event updates)<br />
                <strong>Privacy Policy:</strong>
                <a
                  href="https://resend.com/legal/privacy-policy"
                  target="_blank"
                  rel="noopener noreferrer">resend.com/legal/privacy-policy</a
                >
              </p>
            </div>

            <div class="legal-provider">
              <strong class="legal-provider-name">MXRoute</strong>
              <p>
                <strong>Purpose:</strong> Email hosting provider for @ieeeucsd.org
                accounts<br />
                <strong>Data Shared:</strong> Email account credentials, email content,
                and mailbox data (only for users who request IEEE email accounts)<br
                />
                <strong>Privacy Policy:</strong>
                <a
                  href="https://mxroute.com/privacy-policy/"
                  target="_blank"
                  rel="noopener noreferrer">mxroute.com/privacy-policy</a
                >
              </p>
            </div>

            <div class="legal-provider">
              <strong class="legal-provider-name">OpenRouter AI</strong>
              <p>
                <strong>Purpose:</strong> AI-powered receipt parsing for reimbursement
                automation<br />
                <strong>Data Shared:</strong> Receipt images and extracted text data
                (only when you submit reimbursements)<br />
                <strong>Privacy Policy:</strong>
                <a
                  href="https://openrouter.ai/privacy"
                  target="_blank"
                  rel="noopener noreferrer">openrouter.ai/privacy</a
                >
              </p>
            </div>

            <aside class="legal-note legal-note-danger">
              <p class="legal-note-title">Important: AI Data Processing</p>
              <p>
                Reimbursement receipts, event invoice data, and any other data
                uploaded to AI services is processed by third-party AI providers
                and is outside of our direct control once transmitted. We use AI
                solely to parse and extract data for improved efficiency and
                automation. Please note that AI-generated results may sometimes
                be inaccurate, and we recommend reviewing all AI-parsed data for
                correctness before submission.
              </p>
            </aside>

            <div class="legal-provider">
              <strong class="legal-provider-name">Google Calendar API</strong>
              <p>
                <strong>Purpose:</strong> Event calendar integration and synchronization<br
                />
                <strong>Data Shared:</strong> Event names, dates, locations, and descriptions
                (public event information only)<br />
                <strong>Privacy Policy:</strong>
                <a
                  href="https://policies.google.com/privacy"
                  target="_blank"
                  rel="noopener noreferrer">policies.google.com/privacy</a
                >
              </p>
            </div>
          </div>

          <h3>Legal Requirements</h3>
          <p>
            We may disclose information if required by law, court order,
            subpoena, or to protect the rights, safety, and security of our
            members and organization. We will notify affected users when legally
            permitted.
          </p>
        </section>

        <!-- 4. Data Storage and Security -->
        <section class="legal-section" id="data-storage">
          <h2>4. Data Storage and Security</h2>
          <p class="legal-sub">Where and how we protect your data</p>

          <h3>Storage Locations</h3>
          <ul class="legal-list">
            <li>
              <strong>Primary Storage:</strong> Self-hosted Convex deployment (database
              and file storage) operated in the United States
            </li>
            <li>
              <strong>Email Services:</strong> MXRoute servers for IEEE email hosting
              (location may vary based on service configuration)
            </li>
            <li>
              <strong>Backups:</strong> Encrypted backups of the self-hosted Convex
              deployment for disaster recovery
            </li>
          </ul>

          <h3>Security Measures</h3>
          <ul class="legal-list">
            <li>
              End-to-end encryption for data in transit (HTTPS/TLS) and at rest
            </li>
            <li>
              Role-based access controls enforced through server-side Convex
              functions and dashboard permissions
            </li>
            <li>Regular security audits and dependency updates</li>
            <li>
              Secure authentication using Logto (OpenID Connect / OAuth 2.0)
            </li>
            <li>Automated backups and disaster recovery procedures</li>
          </ul>
        </section>

        <!-- 5. Data Retention -->
        <section class="legal-section" id="data-retention">
          <h2>5. Data Retention</h2>
          <p class="legal-sub">How long we keep your information</p>
          <ul class="legal-rows">
            <li>
              <strong>Active Members:</strong> Personal information retained while
              membership is active and account is in good standing
            </li>
            <li>
              <strong>Inactive Accounts:</strong> May be suspended or archived after
              extended periods of inactivity (typically 2+ years)
            </li>
            <li>
              <strong>Event Data:</strong> Attendance records and participation history
              maintained indefinitely for organizational records and leaderboards
            </li>
            <li>
              <strong>Financial Records:</strong> Reimbursement data and receipts
              retained for 7 years to comply with tax and audit requirements
            </li>
            <li>
              <strong>Legal Obligations:</strong> Some data may be retained longer
              if required by law, legal proceedings, or university policies
            </li>
          </ul>
          <aside class="legal-note">
            <p>
              <strong>Data Deletion:</strong> Members may request data deletion by
              contacting the webmaster. We will comply with deletion requests subject
              to organizational record-keeping requirements and legal obligations.
            </p>
          </aside>
        </section>

        <!-- 6. Your Rights and Choices -->
        <section class="legal-section" id="your-rights">
          <h2>6. Your Rights and Choices</h2>
          <p>
            You have the following rights regarding your personal information:
          </p>

          <div class="legal-columns">
            <div>
              <h3>Access and Portability</h3>
              <ul class="legal-list">
                <li>Request access to your personal data</li>
                <li>Receive a copy of your data in a portable format</li>
                <li>Review your account information and activity</li>
              </ul>
            </div>

            <div>
              <h3>Modification and Deletion</h3>
              <ul class="legal-list">
                <li>Update your personal information</li>
                <li>Request correction of inaccurate data</li>
                <li>Request deletion of your account and data</li>
                <li>Withdraw consent for optional data processing</li>
              </ul>
            </div>
          </div>

          <h3>Resume Management</h3>
          <p>
            You may delete your resume from our platform at any time by going to
            your account Settings page and removing it from your profile. This
            will prevent your resume from being shared with sponsors in the
            future.
          </p>
          <aside class="legal-note legal-note-danger">
            <p class="legal-note-title">Important Notice</p>
            <p>
              Please note that once your resume has been shared with or
              downloaded by sponsors, we cannot retrieve or delete those copies.
              Sponsors may retain resumes in their own recruiting systems
              independently of our platform. We recommend only uploading your
              resume if you are comfortable with it being distributed to our
              sponsor partners.
            </p>
          </aside>
          <aside class="legal-note">
            <p>
              To exercise these rights, contact the Webmaster at
              <a href="mailto:webmaster@ieeeatucsd.org"
                >webmaster@ieeeatucsd.org</a
              >
            </p>
          </aside>
        </section>

        <!-- 7. Cookies and Tracking -->
        <section class="legal-section" id="cookies-tracking">
          <h2>7. Cookies and Tracking</h2>
          <p class="legal-sub">How we use cookies on our site</p>
          <aside class="legal-note">
            <p class="legal-note-title">No Analytics or Tracking</p>
            <p>
              We do <strong>not</strong> use Google Analytics, third-party tracking
              pixels, or advertising cookies. We only use essential cookies required
              for the website to function properly.
            </p>
          </aside>
          <p>
            We use minimal cookies and similar technologies to provide essential
            functionality:
          </p>
          <ul class="legal-list">
            <li>
              <strong>Authentication Cookies (Essential)</strong>
              <span class="legal-list-detail">
                Required for login, session management, and secure access to
                your account. These cookies cannot be disabled as they are
                essential for the website to function.</span
              >
            </li>
            <li>
              <strong>Preference Cookies (Functional)</strong>
              <span class="legal-list-detail">
                Remember your display preferences (theme, language),
                accessibility settings, and notification preferences to enhance
                your experience.</span
              >
            </li>
            <li>
              <strong>Local Storage</strong>
              <span class="legal-list-detail">
                Used to cache data locally for offline functionality and
                improved performance. This includes theme preferences and
                temporary form data.</span
              >
            </li>
          </ul>
          <aside class="legal-note">
            <p>
              <strong>Browser Controls:</strong> You can control cookie settings through
              your browser preferences. Note that disabling essential cookies will
              prevent you from logging in and using authenticated features of the
              website.
            </p>
          </aside>
        </section>

        <!-- 8. International Data Transfers -->
        <section class="legal-section" id="international-transfers">
          <h2>8. International Data Transfers</h2>
          <p class="legal-sub">Cross-border data processing</p>
          <p>
            Our primary data storage is located in the <strong
              >United States</strong
            > through our self-hosted Convex deployment. By using our services, you
            consent to the transfer of your information to the United States.
          </p>
          <p>
            We ensure that any international data transfers comply with
            applicable data protection laws (including GDPR where applicable)
            and maintain appropriate safeguards for your personal information
            through:
          </p>
          <ul class="legal-list">
            <li>
              Standard contractual clauses and provider privacy commitments with
              third-party service providers
            </li>
            <li>Standard contractual clauses with service providers</li>
            <li>Encryption and security measures for data in transit</li>
          </ul>
        </section>

        <!-- 9. Changes to This Policy -->
        <section class="legal-section" id="policy-changes">
          <h2>9. Changes to This Policy</h2>
          <p class="legal-sub">How we notify you of updates</p>
          <p>
            We may update this privacy policy periodically to reflect changes in
            our practices, legal requirements, or new features. Significant
            changes will be communicated through:
          </p>
          <ul class="legal-list">
            <li>Email notifications to active members</li>
            <li>Prominent notices on our website and dashboard</li>
            <li>Updated effective date at the top of this policy</li>
          </ul>
          <aside class="legal-note">
            <p>
              <strong>Important:</strong> Continued use of our services after policy
              changes constitutes acceptance of the updated policy. If you disagree
              with changes, please contact us or discontinue use of the service.
            </p>
          </aside>
        </section>

        <!-- 10. Contact Information -->
        <section class="legal-section" id="contact-info">
          <h2>10. Contact Information</h2>
          <p>
            If you have questions about this privacy policy or our data
            practices, please contact:
          </p>
          <aside class="legal-note">
            <h3>IEEE at UCSD Webmaster</h3>
            <p>
              Email: <a href="mailto:webmaster@ieeeatucsd.org"
                >webmaster@ieeeatucsd.org</a
              >
            </p>
            <p>
              For urgent privacy concerns, please include "PRIVACY" in the
              subject line.
            </p>
          </aside>
          <p class="legal-footnote">
            This privacy policy is maintained by IEEE at UCSD, a student
            organization at the University of California, San Diego. We are
            committed to protecting your privacy and complying with applicable
            data protection laws.
          </p>
        </section>

        <!-- Footer Note -->
        <footer class="legal-footer">
          <p>
            This privacy policy was last reviewed on {
              new Date().toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }. For the most current version, please visit this page directly.
          </p>
        </footer>
      </article>
    </div>
  </div>
</Layout>

<style>
  /* ---------- Layout ---------- */
  .legal-doc :global(.legal-layout) {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  @media (min-width: 1024px) {
    .legal-doc :global(.legal-layout) {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 4.5rem;
    }
  }

  .legal-doc :global(.legal-body) {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---------- Table of contents ---------- */
  .legal-doc :global(.legal-toc-inner) {
    display: none;
  }

  @media (min-width: 1024px) {
    .legal-doc :global(.legal-toc-inner) {
      display: block;
      position: sticky;
      top: 6.5rem;
    }

    .legal-doc :global(.legal-toc-mobile) {
      display: none;
    }
  }

  .legal-doc :global(.legal-toc-summary) {
    cursor: pointer;
    margin-bottom: 1rem;
  }

  .legal-doc :global(.legal-toc-title) {
    margin-bottom: 1.25rem;
  }

  .legal-doc :global(.legal-toc-list) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .legal-doc :global(.legal-toc-link) {
    display: block;
    padding: 0.35rem 0 0.35rem 0.85rem;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition:
      color var(--duration-ui) ease,
      border-color var(--duration-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .legal-doc :global(.legal-toc-link:hover) {
      color: #fff;
      border-left-color: rgba(243, 193, 53, 0.6);
    }
  }

  /* ---------- Header meta ---------- */
  .legal-doc :global(.legal-meta) {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(136, 191, 236, 0.14);
  }

  .legal-doc :global(.legal-updated) {
    font-family: var(--font-ibm-plex-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .legal-doc :global(.legal-meta .legal-intro) {
    margin-top: 1.25rem;
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---------- Sections ---------- */
  .legal-doc :global(.legal-section) {
    scroll-margin-top: 7rem;
  }

  .legal-doc :global(.legal-section + .legal-section) {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(136, 191, 236, 0.14);
  }

  .legal-doc :global(.legal-section > h2) {
    font-size: clamp(1.35rem, 2.1vw, 1.7rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    scroll-margin-top: 7rem;
  }

  .legal-doc :global(.legal-section > .legal-sub) {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.45);
  }

  .legal-doc :global(.legal-section h3) {
    margin-top: 2.5rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #fff;
  }

  /* ---------- Body rhythm ---------- */
  .legal-doc :global(.legal-body p + p),
  .legal-doc :global(.legal-body p + ul),
  .legal-doc :global(.legal-body ul + p) {
    margin-top: 1.15rem;
  }

  .legal-doc :global(.legal-body strong) {
    color: #fff;
    font-weight: 600;
  }

  .legal-doc :global(.legal-body a) {
    text-underline-offset: 0.22em;
  }

  /* ---------- Lists ---------- */
  .legal-doc :global(.legal-list) {
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .legal-doc :global(.legal-list > li) {
    position: relative;
    padding-left: 1.35rem;
  }

  .legal-doc :global(.legal-list > li + li) {
    margin-top: 0.65rem;
  }

  .legal-doc :global(.legal-list > li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 1px;
    background: #f3c135;
  }

  .legal-doc :global(.legal-list-detail) {
    display: block;
    margin-top: 0.2rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---------- Rows ---------- */
