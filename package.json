{
  "name": "ieeeatucsd-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "catalog": {
    "convex": "1.27.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:website": "turbo run dev --filter=@ieeeatucsd/website",
    "dev:dashboard": "turbo run dev --filter=@ieeeatucsd/dashboard",
    "build:website": "turbo run build --filter=@ieeeatucsd/website",
    "build:dashboard": "turbo run build --filter=@ieeeatucsd/dashboard"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.9.16"
  }
}
