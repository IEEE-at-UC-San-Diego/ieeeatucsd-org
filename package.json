{
  "name": "ieeeatucsd-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "catalog": {
    "convex": "1.27.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "check": "vp run -r check",
    "format": "vp run -r format",
    "lint": "vp run -r lint",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "dev:website": "vp run --filter @ieeeatucsd/website dev",
    "dev:dashboard": "vp run --filter @ieeeatucsd/dashboard dev",
    "build:website": "vp run --filter @ieeeatucsd/website build",
    "build:dashboard": "vp run --filter @ieeeatucsd/dashboard build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
